export const dynamic = 'force-dynamic'

import Link from 'next/link'
import { prisma } from '@/lib/prisma'
import PrintButton from '@/components/relatorios/PrintButton'
import { formatCurrency, formatPercent, formatMesRef, SEGMENTO_LABELS, DEAL_STAGE_LABELS, META_TIPO_LABELS } from '@/lib/utils'

const PRINT_CSS = `
@media print {
  aside, .no-print { display: none !important; }
  body { background: white !important; }
  .report-paper { box-shadow: none !important; max-width: none !important; border-radius: 0 !important; margin: 0 !important; }
  .report-wrap { background: white !important; padding: 0 !important; }
  .page-break { page-break-before: always; }
}
@page { size: A4; margin: 15mm 20mm; }
`

const PIPELINE_ORDER = ['PROSPECCAO', 'QUALIFICACAO', 'PROPOSTA', 'NEGOCIACAO', 'FECHAMENTO', 'GANHO', 'PERDIDO']

async function getData() {
  const now = new Date()
  const d11 = new Date(now.getFullYear(), now.getMonth() - 11, 1)
  const startMonth = `${d11.getFullYear()}-${String(d11.getMonth() + 1).padStart(2, '0')}`
  const startDate = new Date(d11)

  const [leads, deals, clientesNovos, parametros, metas, users] = await Promise.all([
    prisma.lead.groupBy({
      by: ['status'],
      _count: { id: true },
      _sum: { value: true },
    }),
    prisma.deal.findMany({
      where: {},
      select: { stage: true, value: true, closedAt: true, ownerId: true, segmento: true, createdAt: true },
    }),
    prisma.cliente.findMany({
      where: {
        dataFechamento: { gte: startDate },
        status: { in: ['ATIVO', 'INATIVO'] },
      },
      select: { nome: true, dataFechamento: true, mensalidadeApi: true, sustentacaoWhiteLabel: true, segmento: true, modeloOperacional: true, tpvEsperado: true },
      orderBy: { dataFechamento: 'desc' },
    }),
    prisma.parametro.findMany({ where: { chave: { in: ['CAC', 'LTV_MESES'] } } }),
    prisma.meta.findMany({ orderBy: [{ tipo: 'asc' }, { periodo: 'desc' }], take: 20 }),
    prisma.user.findMany({ where: { active: true, role: { in: ['COMERCIAL', 'ADMIN'] } }, select: { id: true, name: true } }),
  ])

  return { leads, deals, clientesNovos, parametros, metas, users, startMonth, startDate }
}

function Logo() {
  return (
    <div className="flex items-center gap-2.5">
      <div className="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style={{ background: 'linear-gradient(135deg, #10b981 0%, #0ea5e9 100%)' }}>
        <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2.5" strokeLinecap="round">
          <line x1="4" y1="4" x2="20" y2="20" /><line x1="20" y1="4" x2="4" y2="20" />
          <circle cx="12" cy="12" r="2.5" fill="white" stroke="none" />
        </svg>
      </div>
      <div>
        <p className="text-gray-900 font-bold text-base leading-none">Bass Pago</p>
        <p className="text-gray-400 text-xs mt-0.5">RevenueOps</p>
      </div>
    </div>
  )
}

export default async function ComercialPage() {
  const { leads, deals, clientesNovos, parametros, metas, startMonth } = await getData()

  const now = new Date()
  const dateStr = now.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
  const periodLabel = `${formatMesRef(startMonth)} – ${formatMesRef(`${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`)}`

  const totalLeads = leads.reduce((s, l) => s + l._count, 0)

  const dealsByStage: Record<string, { count: number; value: number }> = {}
  deals.forEach(d => {
    if (!dealsByStage[d.stage]) dealsByStage[d.stage] = { count: 0, value: 0 }
    dealsByStage[d.stage].count++
    dealsByStage[d.stage].value += d.value
  })

  const dealsGanhos = deals.filter(d => d.stage === 'GANHO')
  const dealsPerdidos = deals.filter(d => d.stage === 'PERDIDO')
  const dealsAtivos = deals.filter(d => !['GANHO', 'PERDIDO'].includes(d.stage))

  const totalGanho = dealsGanhos.reduce((s, d) => s + d.value, 0)
  const totalPerdido = dealsPerdidos.reduce((s, d) => s + d.value, 0)
  const totalAtivos = dealsAtivos.reduce((s, d) => s + d.value, 0)
  const taxaConversao = (dealsGanhos.length + dealsPerdidos.length) > 0
    ? (dealsGanhos.length / (dealsGanhos.length + dealsPerdidos.length)) * 100 : 0

  const receitaNovos = clientesNovos.reduce((s, c) => s + (c.mensalidadeApi || 0) + (c.sustentacaoWhiteLabel || 0), 0)

  const cac = Number(parametros.find(p => p.chave === 'CAC')?.valor || 0)
  const ltvMeses = Number(parametros.find(p => p.chave === 'LTV_MESES')?.valor || 24)
  const mrrPorCliente = receitaNovos > 0 && clientesNovos.length > 0 ? receitaNovos / clientesNovos.length : 0
  const ltv = mrrPorCliente * ltvMeses
  const ltvCac = ltv > 0 && cac > 0 ? ltv / cac : null

  const metasComerciais = metas.filter(m => ['NOVOS_CLIENTES', 'RECEITA', 'TPV'].includes(m.tipo))

  const STAGE_COLORS: Record<string, string> = {
    PROSPECCAO: 'bg-gray-100 text-gray-600', QUALIFICACAO: 'bg-sky-100 text-sky-700',
    PROPOSTA: 'bg-amber-100 text-amber-700', NEGOCIACAO: 'bg-orange-100 text-orange-700',
    FECHAMENTO: 'bg-violet-100 text-violet-700', GANHO: 'bg-emerald-100 text-emerald-700', PERDIDO: 'bg-red-100 text-red-700',
  }

  return (
    <>
      <style>{PRINT_CSS}</style>
      <div className="report-wrap min-h-screen bg-gray-100 py-8 px-6">
        <div className="no-print max-w-4xl mx-auto mb-5 flex items-center justify-between">
          <Link href="/dashboard/relatorios" className="text-gray-500 hover:text-gray-800 text-sm flex items-center gap-1.5 transition-colors">← Relatórios</Link>
          <PrintButton label="Exportar PDF" />
        </div>

        <div className="report-paper max-w-4xl mx-auto bg-white shadow-2xl rounded-2xl overflow-hidden">
          <div className="h-2" style={{ background: 'linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%)' }} />

          <div className="p-10">
            <div className="flex items-start justify-between mb-8 pb-6 border-b-2 border-gray-100">
              <Logo />
              <div className="text-right">
                <h1 className="text-2xl font-bold text-gray-900">Relatório Comercial</h1>
                <p className="text-gray-500 text-sm mt-1">{periodLabel}</p>
                <p className="text-gray-400 text-xs mt-0.5">Gerado em {dateStr} · CCO / Vendas</p>
              </div>
            </div>

            <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Resumo Comercial</h2>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
              <div className="border border-gray-200 rounded-lg p-4">
                <p className="text-gray-500 text-[10px] font-semibold uppercase tracking-widest mb-1.5">Novos Clientes</p>
                <p className="text-2xl font-bold text-gray-900">{clientesNovos.length}</p>
                <p className="text-gray-400 text-xs mt-1.5">Últimos 12 meses</p>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <p className="text-gray-500 text-[10px] font-semibold uppercase tracking-widest mb-1.5">Receita Gerada</p>
                <p className="text-2xl font-bold text-gray-900">{receitaNovos > 0 ? formatCurrency(receitaNovos) : '—'}</p>
                <p className="text-gray-400 text-xs mt-1.5">MRR dos novos clientes</p>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <p className="text-gray-500 text-[10px] font-semibold uppercase tracking-widest mb-1.5">Taxa de Conversão</p>
                <p className={`text-2xl font-bold ${taxaConversao >= 30 ? 'text-emerald-600' : taxaConversao > 0 ? 'text-amber-500' : 'text-gray-900'}`}>
                  {taxaConversao > 0 ? formatPercent(taxaConversao, 1) : '—'}
                </p>
                <p className="text-gray-400 text-xs mt-1.5">{dealsGanhos.length} ganhos / {dealsGanhos.length + dealsPerdidos.length} fechados</p>
              </div>
              <div className="border border-gray-200 rounded-lg p-4">
                <p className="text-gray-500 text-[10px] font-semibold uppercase tracking-widest mb-1.5">Receita Perdida</p>
                <p className="text-2xl font-bold text-red-500">{totalPerdido > 0 ? formatCurrency(totalPerdido) : '—'}</p>
                <p className="text-gray-400 text-xs mt-1.5">{dealsPerdidos.length} deals perdidos</p>
              </div>
            </div>

            {cac > 0 && (
              <div className="mb-8">
                <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">LTV / CAC</h2>
                <div className="grid grid-cols-3 gap-4">
                  <div className="border border-gray-200 rounded-lg p-4 text-center">
                    <p className="text-[10px] text-gray-500 font-semibold uppercase tracking-wide mb-2">LTV Estimado</p>
                    <p className="text-xl font-bold text-gray-900">{ltv > 0 ? formatCurrency(ltv) : '—'}</p>
                    <p className="text-xs text-gray-400 mt-1">MRR médio × {ltvMeses} meses</p>
                  </div>
                  <div className="border border-gray-200 rounded-lg p-4 text-center">
                    <p className="text-[10px] text-gray-500 font-semibold uppercase tracking-wide mb-2">CAC</p>
                    <p className="text-xl font-bold text-gray-900">{formatCurrency(cac)}</p>
                    <p className="text-xs text-gray-400 mt-1">Custo de aquisição</p>
                  </div>
                  <div className={`border rounded-lg p-4 text-center ${ltvCac != null ? (ltvCac >= 3 ? 'border-emerald-200 bg-emerald-50' : ltvCac >= 1.5 ? 'border-amber-200 bg-amber-50' : 'border-red-200 bg-red-50') : 'border-gray-200'}`}>
                    <p className="text-[10px] text-gray-500 font-semibold uppercase tracking-wide mb-2">LTV / CAC</p>
                    <p className={`text-xl font-bold ${ltvCac != null ? (ltvCac >= 3 ? 'text-emerald-600' : ltvCac >= 1.5 ? 'text-amber-500' : 'text-red-500') : 'text-gray-900'}`}>
                      {ltvCac != null ? `${ltvCac.toFixed(1)}x` : '—'}
                    </p>
                    <p className="text-xs text-gray-400 mt-1">{ltvCac != null ? (ltvCac >= 3 ? 'Excelente (≥3x)' : ltvCac >= 1.5 ? 'Adequado' : 'Abaixo do ideal') : 'Sem dados'}</p>
                  </div>
                </div>
              </div>
            )}

            <div className="mb-10">
              <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Pipeline de Deals</h2>
              <div className="grid grid-cols-2 gap-4 mb-4">
                <div className="border border-gray-200 rounded-lg p-4 flex items-center justify-between">
                  <div>
                    <p className="text-xs text-gray-500 font-semibold uppercase tracking-wide">Em Negociação</p>
                    <p className="text-gray-400 text-xs mt-1">{dealsAtivos.length} deals ativos</p>
                  </div>
                  <p className="text-2xl font-bold text-sky-600">{formatCurrency(totalAtivos)}</p>
                </div>
                <div className="border border-emerald-200 rounded-lg p-4 flex items-center justify-between bg-emerald-50">
                  <div>
                    <p className="text-xs text-emerald-700 font-semibold uppercase tracking-wide">Receita Ganho</p>
                    <p className="text-emerald-600 text-xs mt-1">{dealsGanhos.length} deals fechados</p>
                  </div>
                  <p className="text-2xl font-bold text-emerald-600">{formatCurrency(totalGanho)}</p>
                </div>
              </div>
              <table className="w-full text-sm border-collapse">
                <thead>
                  <tr className="border-b-2 border-gray-200">
                    {['Etapa', 'Deals', 'Valor Total', 'Share'].map(h => (
                      <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Etapa' ? 'text-left' : 'text-right'}`}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {PIPELINE_ORDER.filter(s => dealsByStage[s]).map(stage => {
                    const d = dealsByStage[stage]
                    const share = deals.length > 0 ? (d.count / deals.length) * 100 : 0
                    return (
                      <tr key={stage} className="border-b border-gray-100">
                        <td className="py-2">
                          <span className={`text-xs px-2 py-0.5 rounded-full font-semibold ${STAGE_COLORS[stage] || 'bg-gray-100 text-gray-600'}`}>
                            {DEAL_STAGE_LABELS[stage] || stage}
                          </span>
                        </td>
                        <td className="py-2 text-right text-gray-700">{d.count}</td>
                        <td className="py-2 text-right text-gray-900 font-semibold">{formatCurrency(d.value)}</td>
                        <td className="py-2 text-right text-gray-500">{formatPercent(share, 1)}</td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>

            <div className="mb-10">
              <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Pipeline de Leads</h2>
              <table className="w-full text-sm border-collapse">
                <thead>
                  <tr className="border-b-2 border-gray-200">
                    {['Status', 'Qtd.', 'Valor Potencial', 'Share'].map(h => (
                      <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Status' ? 'text-left' : 'text-right'}`}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {leads.map(l => {
                    const share = totalLeads > 0 ? (l._count / totalLeads) * 100 : 0
                    return (
                      <tr key={l.status} className="border-b border-gray-100">
                        <td className="py-2 text-gray-900 font-medium">{l.status}</td>
                        <td className="py-2 text-right text-gray-700">{l._count}</td>
                        <td className="py-2 text-right text-gray-700">{l._sum.value != null ? formatCurrency(l._sum.value) : '—'}</td>
                        <td className="py-2 text-right text-gray-500">{formatPercent(share, 1)}</td>
                      </tr>
                    )
                  })}
                  <tr className="bg-gray-50 border-t-2 border-gray-300">
                    <td className="py-2 text-gray-700 font-bold text-xs">TOTAL</td>
                    <td className="py-2 text-right text-gray-800 font-bold">{totalLeads}</td>
                    <td className="py-2 text-right text-gray-800 font-bold">{formatCurrency(leads.reduce((s, l) => s + (l._sum.value || 0), 0))}</td>
                    <td className="py-2 text-right text-gray-500 font-bold">100%</td>
                  </tr>
                </tbody>
              </table>
            </div>

            {clientesNovos.length > 0 && (
              <div className="mb-10 page-break">
                <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Novos Clientes — {periodLabel}</h2>
                <table className="w-full text-sm border-collapse">
                  <thead>
                    <tr className="border-b-2 border-gray-200">
                      {['Cliente', 'Fechamento', 'Segmento', 'Modelo', 'MRR', 'TPV Esperado'].map(h => (
                        <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Cliente' ? 'text-left' : h === 'Segmento' || h === 'Modelo' ? 'text-left' : 'text-right'}`}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {clientesNovos.map((c, i) => {
                      const clienteMrr = (c.mensalidadeApi || 0) + (c.sustentacaoWhiteLabel || 0)
                      return (
                        <tr key={i} className="border-b border-gray-100">
                          <td className="py-2 text-gray-900 font-medium">{c.nome}</td>
                          <td className="py-2 text-gray-500 text-xs">{c.dataFechamento ? new Date(c.dataFechamento).toLocaleDateString('pt-BR') : '—'}</td>
                          <td className="py-2 text-gray-600 text-xs">{c.segmento ? SEGMENTO_LABELS[c.segmento] : '—'}</td>
                          <td className="py-2 text-gray-600 text-xs">{c.modeloOperacional === 'API' ? 'API' : 'White Label'}</td>
                          <td className="py-2 text-right text-gray-900 font-semibold">{clienteMrr > 0 ? formatCurrency(clienteMrr) : '—'}</td>
                          <td className="py-2 text-right text-gray-600">{c.tpvEsperado ? formatCurrency(c.tpvEsperado) : '—'}</td>
                        </tr>
                      )
                    })}
                    <tr className="bg-gray-50 border-t-2 border-gray-300">
                      <td className="py-2 text-gray-700 font-bold text-xs" colSpan={4}>TOTAL MRR GERADO</td>
                      <td className="py-2 text-right text-gray-900 font-bold">{formatCurrency(receitaNovos)}</td>
                      <td />
                    </tr>
                  </tbody>
                </table>
              </div>
            )}

            {metasComerciais.length > 0 && (
              <div className="mb-10">
                <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Metas Comerciais</h2>
                <table className="w-full text-sm border-collapse">
                  <thead>
                    <tr className="border-b-2 border-gray-200">
                      {['Indicador', 'Período', 'Meta', 'Realizado', 'Gap', '%'].map(h => (
                        <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Indicador' || h === 'Período' ? 'text-left' : 'text-right'}`}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {metasComerciais.map(m => {
                      const pct = m.realizado != null && m.valor > 0 ? (m.realizado / m.valor) * 100 : null
                      const gap = m.realizado != null ? m.realizado - m.valor : null
                      return (
                        <tr key={m.id} className="border-b border-gray-100">
                          <td className="py-2 text-gray-900 font-medium">{META_TIPO_LABELS[m.tipo] || m.tipo}</td>
                          <td className="py-2 text-gray-500 text-xs">{m.periodo}</td>
                          <td className="py-2 text-right text-gray-700">{m.valor.toLocaleString('pt-BR')}</td>
                          <td className="py-2 text-right text-gray-900 font-semibold">{m.realizado != null ? m.realizado.toLocaleString('pt-BR') : '—'}</td>
                          <td className={`py-2 text-right font-medium ${gap == null ? 'text-gray-400' : gap >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                            {gap != null ? (gap >= 0 ? '+' : '') + gap.toLocaleString('pt-BR') : '—'}
                          </td>
                          <td className={`py-2 text-right font-bold ${pct == null ? 'text-gray-400' : pct >= 100 ? 'text-emerald-600' : pct >= 80 ? 'text-amber-500' : 'text-red-500'}`}>
                            {pct != null ? formatPercent(pct, 1) : '—'}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </div>

          <div className="px-10 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
            <p className="text-xs text-gray-400">Bass Pago · RevenueOps · Relatório Comercial — CCO / Vendas</p>
            <p className="text-xs text-gray-400">Gerado em {dateStr}</p>
          </div>
        </div>
      </div>
    </>
  )
}
