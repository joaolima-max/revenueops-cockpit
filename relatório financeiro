export const dynamic = 'force-dynamic'

import Link from 'next/link'
import { prisma } from '@/lib/prisma'
import PrintButton from '@/components/relatorios/PrintButton'
import { formatCurrency, formatPercent, formatMesRef, formatDate } from '@/lib/utils'

const PRINT_CSS = `
@media print {
  aside, .no-print { display: none !important; }
  body { background: white !important; }
  .report-paper { box-shadow: none !important; max-width: none !important; border-radius: 0 !important; margin: 0 !important; }
  .report-wrap { background: white !important; padding: 0 !important; }
  .page-break { page-break-before: always; }
}
@page { size: A4; margin: 15mm 20mm; }
`

async function getData() {
  const now = new Date()
  const d11 = new Date(now.getFullYear(), now.getMonth() - 11, 1)
  const startMonth = `${d11.getFullYear()}-${String(d11.getMonth() + 1).padStart(2, '0')}`

  const [receitaRealizada, contas, pedidos, forecasts, clientesAtivos] = await Promise.all([
    prisma.receitaRealizada.findMany({
      where: { mesRef: { gte: startMonth } },
      orderBy: { mesRef: 'asc' },
    }),
    prisma.contaReceber.findMany({
      orderBy: { dataVenc: 'desc' },
      include: { cliente: { select: { nome: true } } },
    }),
    prisma.pedidoCobravel.findMany({
      where: { mesRef: { gte: startMonth } },
      orderBy: { mesRef: 'desc' },
      include: { cliente: { select: { nome: true } } },
    }),
    prisma.forecastGeral.findMany({
      where: { mesRef: { gte: startMonth } },
      orderBy: { mesRef: 'asc' },
    }),
    prisma.cliente.findMany({
      where: { status: 'ATIVO' },
      select: { mensalidadeApi: true, sustentacaoWhiteLabel: true },
    }),
  ])

  return { receitaRealizada, contas, pedidos, forecasts, clientesAtivos, startMonth }
}

function Logo() {
  return (
    <div className="flex items-center gap-2.5">
      <div className="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style={{ background: 'linear-gradient(135deg, #10b981 0%, #0ea5e9 100%)' }}>
        <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2.5" strokeLinecap="round">
          <line x1="4" y1="4" x2="20" y2="20" /><line x1="20" y1="4" x2="4" y2="20" />
          <circle cx="12" cy="12" r="2.5" fill="white" stroke="none" />
        </svg>
      </div>
      <div>
        <p className="text-gray-900 font-bold text-base leading-none">Bass Pago</p>
        <p className="text-gray-400 text-xs mt-0.5">RevenueOps</p>
      </div>
    </div>
  )
}

function KpiBox({ label, value, sub, alert }: { label: string; value: string; sub?: string; alert?: boolean }) {
  return (
    <div className={`border rounded-lg p-4 ${alert ? 'border-red-200 bg-red-50' : 'border-gray-200'}`}>
      <p className="text-gray-500 text-[10px] font-semibold uppercase tracking-widest mb-1.5">{label}</p>
      <p className={`text-2xl font-bold leading-none ${alert ? 'text-red-600' : 'text-gray-900'}`}>{value}</p>
      {sub && <p className="text-gray-400 text-xs mt-1.5">{sub}</p>}
    </div>
  )
}

export default async function FinanceiroPage() {
  const { receitaRealizada, contas, pedidos, forecasts, clientesAtivos, startMonth } = await getData()

  const now = new Date()
  const dateStr = now.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
  const periodLabel = `${formatMesRef(startMonth)} – ${formatMesRef(`${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`)}`

  const totTarifaria = receitaRealizada.reduce((s, r) => s + r.receitaTarifaria, 0)
  const totFloating = receitaRealizada.reduce((s, r) => s + r.floatingRealizado, 0)
  const totReceita = totTarifaria + totFloating
  const mrr = clientesAtivos.reduce((s, c) => s + (c.mensalidadeApi || 0) + (c.sustentacaoWhiteLabel || 0), 0)

  const totalContas = contas.reduce((s, c) => s + c.valor, 0)
  const inadimplente = contas.filter(c => c.status === 'INADIMPLENTE')
  const totalInadimplente = inadimplente.reduce((s, c) => s + c.valor, 0)
  const emAberto = contas.filter(c => c.status === 'PENDENTE' || c.status === 'FATURADO')
  const totalEmAberto = emAberto.reduce((s, c) => s + c.valor, 0)
  const totalPago = contas.filter(c => c.status === 'PAGO').reduce((s, c) => s + c.valor, 0)
  const taxaInadimplencia = totalContas > 0 ? (totalInadimplente / totalContas) * 100 : 0

  const pedidosByTipo: Record<string, { count: number; total: number }> = {}
  pedidos.forEach(p => {
    if (!pedidosByTipo[p.tipo]) pedidosByTipo[p.tipo] = { count: 0, total: 0 }
    pedidosByTipo[p.tipo].count++
    pedidosByTipo[p.tipo].total += p.valor
  })
  const totalPedidos = pedidos.reduce((s, p) => s + p.valor, 0)

  const fwComp = forecasts.filter(f => f.faturamentoRealizado != null && (f.faturamentoPrevisto || 0) > 0)
  const forecastPrec = fwComp.length > 0 ? fwComp.reduce((s, f) => s + ((f.faturamentoRealizado! / (f.faturamentoPrevisto || 1)) * 100), 0) / fwComp.length : null

  const STATUS_LABELS: Record<string, string> = { PENDENTE: 'Pendente', FATURADO: 'Faturado', PAGO: 'Pago', INADIMPLENTE: 'Inadimplente', CANCELADO: 'Cancelado' }

  return (
    <>
      <style>{PRINT_CSS}</style>
      <div className="report-wrap min-h-screen bg-gray-100 py-8 px-6">
        <div className="no-print max-w-4xl mx-auto mb-5 flex items-center justify-between">
          <Link href="/dashboard/relatorios" className="text-gray-500 hover:text-gray-800 text-sm flex items-center gap-1.5 transition-colors">← Relatórios</Link>
          <PrintButton label="Exportar PDF" />
        </div>

        <div className="report-paper max-w-4xl mx-auto bg-white shadow-2xl rounded-2xl overflow-hidden">
          <div className="h-2" style={{ background: 'linear-gradient(135deg, #10b981 0%, #059669 100%)' }} />

          <div className="p-10">
            <div className="flex items-start justify-between mb-8 pb-6 border-b-2 border-gray-100">
              <Logo />
              <div className="text-right">
                <span className="text-xs font-bold text-red-500 tracking-widest">CONFIDENCIAL</span>
                <h1 className="text-2xl font-bold text-gray-900 mt-1">Relatório Financeiro</h1>
                <p className="text-gray-500 text-sm mt-1">{periodLabel}</p>
                <p className="text-gray-400 text-xs mt-0.5">Gerado em {dateStr} · CFO / Financeiro</p>
              </div>
            </div>

            <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Resumo Financeiro</h2>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
              <KpiBox label="Receita Total" value={formatCurrency(totReceita)} sub="Tarifária + Floating" />
              <KpiBox label="Receita Tarifária" value={formatCurrency(totTarifaria)} sub="Transações no período" />
              <KpiBox label="Floating" value={formatCurrency(totFloating)} sub="Rendimento em trânsito" />
              <KpiBox label="MRR" value={mrr > 0 ? formatCurrency(mrr) : '—'} sub="Receita recorrente mensal" />
            </div>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
              <KpiBox label="Total a Receber" value={formatCurrency(totalEmAberto)} sub={`${emAberto.length} cobranças`} />
              <KpiBox label="Inadimplência" value={formatCurrency(totalInadimplente)} sub={`${formatPercent(taxaInadimplencia, 1)} da carteira`} alert={totalInadimplente > 0} />
              <KpiBox label="Recebido" value={formatCurrency(totalPago)} sub="Total pago no histórico" />
              <KpiBox label="Precisão Forecast" value={forecastPrec != null ? formatPercent(forecastPrec, 1) : '—'} sub={forecastPrec != null ? (forecastPrec >= 90 ? 'Excelente' : forecastPrec >= 80 ? 'Boa' : 'Atenção') : 'Sem dados'} />
            </div>

            {receitaRealizada.length > 0 && (
              <div className="mb-10">
                <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Receita Realizada — Mensal</h2>
                <table className="w-full text-sm border-collapse">
                  <thead>
                    <tr className="border-b-2 border-gray-200">
                      {['Mês', 'Tarifária', 'Floating', 'Total', 'MoM'].map(h => (
                        <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Mês' ? 'text-left' : 'text-right'}`}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {receitaRealizada.map((r, i) => {
                      const total = r.receitaTarifaria + r.floatingRealizado
                      const prev = receitaRealizada[i - 1]
                      const prevTotal = prev ? prev.receitaTarifaria + prev.floatingRealizado : null
                      const mom = prevTotal && prevTotal > 0 ? ((total - prevTotal) / prevTotal) * 100 : null
                      return (
                        <tr key={r.mesRef} className="border-b border-gray-100">
                          <td className="py-2 text-gray-900 font-medium">{formatMesRef(r.mesRef)}</td>
                          <td className="py-2 text-right text-gray-700">{formatCurrency(r.receitaTarifaria)}</td>
                          <td className="py-2 text-right text-gray-700">{formatCurrency(r.floatingRealizado)}</td>
                          <td className="py-2 text-right text-gray-900 font-semibold">{formatCurrency(total)}</td>
                          <td className={`py-2 text-right text-sm font-medium ${mom == null ? 'text-gray-400' : mom >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                            {mom != null ? `${mom >= 0 ? '▲' : '▼'} ${Math.abs(mom).toFixed(1)}%` : '—'}
                          </td>
                        </tr>
                      )
                    })}
                    <tr className="bg-gray-50 border-t-2 border-gray-300">
                      <td className="py-2.5 text-gray-700 font-bold text-xs">TOTAL</td>
                      <td className="py-2.5 text-right text-gray-800 font-bold">{formatCurrency(totTarifaria)}</td>
                      <td className="py-2.5 text-right text-gray-800 font-bold">{formatCurrency(totFloating)}</td>
                      <td className="py-2.5 text-right text-gray-900 font-bold">{formatCurrency(totReceita)}</td>
                      <td className="py-2.5 text-right text-gray-400">—</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            )}

            {forecasts.length > 0 && (
              <div className="mb-10">
                <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Receita Prevista vs Realizada · Precisão do Forecast</h2>
                <table className="w-full text-sm border-collapse">
                  <thead>
                    <tr className="border-b-2 border-gray-200">
                      {['Mês', 'Previsto', 'Realizado', 'Desvio', 'Precisão', 'Margem Prev.', 'Margem Real.'].map(h => (
                        <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Mês' ? 'text-left' : 'text-right'}`}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {forecasts.map(f => {
                      const prec = f.faturamentoRealizado != null && (f.faturamentoPrevisto || 0) > 0
                        ? (f.faturamentoRealizado / (f.faturamentoPrevisto || 1)) * 100 : null
                      const desvio = f.faturamentoRealizado != null ? f.faturamentoRealizado - (f.faturamentoPrevisto || 0) : null
                      return (
                        <tr key={f.mesRef} className="border-b border-gray-100">
                          <td className="py-2 text-gray-900 font-medium">{formatMesRef(f.mesRef)}</td>
                          <td className="py-2 text-right text-gray-700">{formatCurrency(f.faturamentoPrevisto)}</td>
                          <td className="py-2 text-right text-gray-900 font-semibold">{f.faturamentoRealizado != null ? formatCurrency(f.faturamentoRealizado) : '—'}</td>
                          <td className={`py-2 text-right font-medium text-sm ${desvio == null ? 'text-gray-400' : desvio >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                            {desvio != null ? (desvio >= 0 ? '+' : '') + formatCurrency(desvio) : '—'}
                          </td>
                          <td className={`py-2 text-right font-bold ${prec == null ? 'text-gray-400' : prec >= 90 ? 'text-emerald-600' : prec >= 70 ? 'text-amber-500' : 'text-red-500'}`}>
                            {prec != null ? formatPercent(prec, 1) : '—'}
                          </td>
                          <td className="py-2 text-right text-gray-600">{f.margemPrevista > 0 ? formatPercent(f.margemPrevista, 1) : '—'}</td>
                          <td className="py-2 text-right text-gray-600">{f.margemRealizada != null ? formatPercent(f.margemRealizada, 1) : '—'}</td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
                {forecastPrec != null && (
                  <div className="mt-3 p-3 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-between">
                    <span className="text-xs text-gray-500">Precisão média do forecast no período</span>
                    <span className={`text-lg font-bold ${forecastPrec >= 90 ? 'text-emerald-600' : forecastPrec >= 70 ? 'text-amber-500' : 'text-red-500'}`}>{formatPercent(forecastPrec, 1)}</span>
                  </div>
                )}
              </div>
            )}

            {Object.keys(pedidosByTipo).length > 0 && (
              <div className="mb-10 page-break">
                <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Serviços e Pedidos Cobráveis — por Tipo</h2>
                <table className="w-full text-sm border-collapse">
                  <thead>
                    <tr className="border-b-2 border-gray-200">
                      {['Tipo', 'Qtd.', 'Total', 'Share'].map(h => (
                        <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Tipo' ? 'text-left' : 'text-right'}`}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {Object.entries(pedidosByTipo).sort((a, b) => b[1].total - a[1].total).map(([tipo, data]) => {
                      const share = totalPedidos > 0 ? (data.total / totalPedidos) * 100 : 0
                      return (
                        <tr key={tipo} className="border-b border-gray-100">
                          <td className="py-2 text-gray-900 font-medium">{tipo}</td>
                          <td className="py-2 text-right text-gray-600">{data.count}</td>
                          <td className="py-2 text-right text-gray-900 font-semibold">{formatCurrency(data.total)}</td>
                          <td className="py-2 text-right text-gray-500">{formatPercent(share, 1)}</td>
                        </tr>
                      )
                    })}
                    <tr className="bg-gray-50 border-t-2 border-gray-300">
                      <td className="py-2 text-gray-700 font-bold text-xs">TOTAL</td>
                      <td className="py-2 text-right text-gray-600 font-bold">{pedidos.length}</td>
                      <td className="py-2 text-right text-gray-900 font-bold">{formatCurrency(totalPedidos)}</td>
                      <td className="py-2 text-right text-gray-500 font-bold">100%</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            )}

            <div className="mb-10">
              <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Contas a Receber — Inadimplência e Abertos</h2>
              <div className="grid grid-cols-3 gap-4 mb-6">
                <div className="border border-gray-200 rounded-lg p-4 text-center">
                  <p className="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-2">Em Aberto</p>
                  <p className="text-xl font-bold text-gray-900">{formatCurrency(totalEmAberto)}</p>
                  <p className="text-xs text-gray-400 mt-1">{emAberto.length} cobranças</p>
                </div>
                <div className={`border rounded-lg p-4 text-center ${totalInadimplente > 0 ? 'border-red-200 bg-red-50' : 'border-gray-200'}`}>
                  <p className={`text-xs font-semibold uppercase tracking-wide mb-2 ${totalInadimplente > 0 ? 'text-red-600' : 'text-gray-500'}`}>Inadimplente</p>
                  <p className={`text-xl font-bold ${totalInadimplente > 0 ? 'text-red-600' : 'text-gray-900'}`}>{formatCurrency(totalInadimplente)}</p>
                  <p className="text-xs text-gray-400 mt-1">{inadimplente.length} casos · {formatPercent(taxaInadimplencia, 1)}</p>
                </div>
                <div className="border border-gray-200 rounded-lg p-4 text-center">
                  <p className="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-2">Recebido</p>
                  <p className="text-xl font-bold text-emerald-600">{formatCurrency(totalPago)}</p>
                  <p className="text-xs text-gray-400 mt-1">{contas.filter(c => c.status === 'PAGO').length} cobranças pagas</p>
                </div>
              </div>

              {inadimplente.length > 0 && (
                <>
                  <p className="text-xs font-semibold text-red-600 uppercase tracking-wide mb-2">Casos Inadimplentes</p>
                  <table className="w-full text-sm border-collapse">
                    <thead>
                      <tr className="border-b-2 border-red-200 bg-red-50">
                        {['Cliente', 'Descrição', 'Vencimento', 'Valor'].map(h => (
                          <th key={h} className={`text-xs text-red-600 font-semibold py-2 ${h === 'Valor' ? 'text-right' : 'text-left'}`}>{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {inadimplente.map(c => (
                        <tr key={c.id} className="border-b border-red-100 bg-red-50">
                          <td className="py-2 text-gray-900 font-medium">{c.cliente.nome}</td>
                          <td className="py-2 text-gray-600 text-xs">{c.descricao}</td>
                          <td className="py-2 text-gray-600 text-xs">{formatDate(c.dataVenc)}</td>
                          <td className="py-2 text-right text-red-600 font-bold">{formatCurrency(c.valor)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </>
              )}

              {emAberto.length > 0 && (
                <>
                  <p className="text-xs font-semibold text-gray-500 uppercase tracking-wide mt-5 mb-2">Cobranças em Aberto</p>
                  <table className="w-full text-sm border-collapse">
                    <thead>
                      <tr className="border-b-2 border-gray-200">
                        {['Cliente', 'Descrição', 'Vencimento', 'Status', 'Valor'].map(h => (
                          <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Valor' ? 'text-right' : 'text-left'}`}>{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {emAberto.slice(0, 15).map(c => (
                        <tr key={c.id} className="border-b border-gray-100">
                          <td className="py-2 text-gray-900 font-medium text-sm">{c.cliente.nome}</td>
                          <td className="py-2 text-gray-500 text-xs">{c.descricao}</td>
                          <td className="py-2 text-gray-500 text-xs">{formatDate(c.dataVenc)}</td>
                          <td className="py-2 text-xs">
                            <span className={`px-1.5 py-0.5 rounded text-[10px] font-semibold ${c.status === 'FATURADO' ? 'bg-blue-100 text-blue-700' : 'bg-amber-100 text-amber-700'}`}>
                              {STATUS_LABELS[c.status] || c.status}
                            </span>
                          </td>
                          <td className="py-2 text-right text-gray-900 font-semibold">{formatCurrency(c.valor)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  {emAberto.length > 15 && <p className="text-xs text-gray-400 mt-2 text-right">+{emAberto.length - 15} cobranças não exibidas</p>}
                </>
              )}
            </div>
          </div>

          <div className="px-10 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
            <p className="text-xs text-gray-400">Bass Pago · RevenueOps · Documento Confidencial — CFO / Financeiro</p>
            <p className="text-xs text-gray-400">Gerado em {dateStr}</p>
          </div>
        </div>
      </div>
    </>
  )
}
