const PRINT_CSS = `
@media print {
  aside, .no-print { display: none !important; }
  body { background: white !important; }
  .report-paper { box-shadow: none !important; max-width: none !important; border-radius: 0 !important; margin: 0 !important; }
  .report-wrap { background: white !important; padding: 0 !important; }
  .page-break { page-break-before: always; }
}
@page { size: A4; margin: 15mm 20mm; }
`

async function getData() {
  const now = new Date()
  const currentYear = now.getFullYear()
  const d11 = new Date(now.getFullYear(), now.getMonth() - 11, 1)
  const startMonth = `${d11.getFullYear()}-${String(d11.getMonth() + 1).padStart(2, '0')}`
  const prevYear = currentYear - 1
  const startPrevYear = `${prevYear}-01`
  const endPrevYear = `${prevYear}-12`

  const [monthlyProc, forecasts, metas, clientesAtivos, segmentoGroup, statusGroup, parametros] = await Promise.all([
    prisma.processamento.groupBy({
      by: ['mesRef'],
      _sum: { tpv: true, receitaTarifaria: true, floating: true, qtdTransacoes: true, qtdMed: true },
      where: { mesRef: { gte: startMonth } },
      orderBy: { mesRef: 'asc' },
    }),
    prisma.forecastGeral.findMany({
      where: { mesRef: { gte: startMonth } },
      orderBy: { mesRef: 'asc' },
    }),
    prisma.meta.findMany({
      where: { periodo: { startsWith: String(currentYear) } },
      orderBy: { tipo: 'asc' },
    }),
    prisma.cliente.findMany({
      where: { status: 'ATIVO' },
      select: { mensalidadeApi: true, sustentacaoWhiteLabel: true, segmento: true, modeloOperacional: true },
    }),
    prisma.cliente.groupBy({
      by: ['segmento'],
      _count: { id: true },
      where: { status: 'ATIVO' },
    }),
    prisma.cliente.groupBy({
      by: ['status'],
      _count: { id: true },
    }),
    prisma.parametro.findMany({ where: { chave: { in: ['CAC', 'LTV_MESES'] } } }),
  ])

  const topClientsRaw = await prisma.processamento.groupBy({
    by: ['clienteId'],
    _sum: { tpv: true, receitaTarifaria: true, floating: true },
    where: { mesRef: { gte: startMonth } },
    orderBy: { _sum: { receitaTarifaria: 'desc' } },
    take: 10,
  })
  const topClientIds = topClientsRaw.map(t => t.clienteId)
  const topClientData = topClientIds.length > 0 ? await prisma.cliente.findMany({
    where: { id: { in: topClientIds } },
    select: { id: true, nome: true, segmento: true, modeloOperacional: true },
  }) : []

  const prevYearProc = await prisma.processamento.groupBy({
    by: ['mesRef'],
    _sum: { tpv: true, receitaTarifaria: true, floating: true },
    where: { mesRef: { gte: startPrevYear, lte: endPrevYear } },
  })

  return { monthlyProc, forecasts, metas, clientesAtivos, segmentoGroup, statusGroup, parametros, topClientsRaw, topClientData, prevYearProc, currentYear, startMonth }
}

function Logo() {
  return (
    <div className="flex items-center gap-2.5">
      <div className="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style={{ background: 'linear-gradient(135deg, #10b981 0%, #0ea5e9 100%)' }}>
        <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2.5" strokeLinecap="round">
          <line x1="4" y1="4" x2="20" y2="20" /><line x1="20" y1="4" x2="4" y2="20" />
          <circle cx="12" cy="12" r="2.5" fill="white" stroke="none" />
        </svg>
      </div>
      <div>
        <p className="text-gray-900 font-bold text-base leading-none">Bass Pago</p>
        <p className="text-gray-400 text-xs mt-0.5">RevenueOps</p>
      </div>
    </div>
