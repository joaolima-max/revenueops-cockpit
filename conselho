                    {forecastPrec != null && forecastPrec < 80 && <p>• Precisão de forecast abaixo de 80% — impacto no planejamento</p>}
                    {ativos < 5 && <p>• Base ativa reduzida — risco de dependência de poucos clientes</p>}
                    {metasComRealizado.some(m => m.realizado != null && m.realizado < m.valor * 0.8) && <p>• Metas abaixo de 80% de atingimento identificadas</p>}
                    {top3Share <= 50 && forecastPrec != null && forecastPrec >= 80 && ativos >= 5 && <p className="text-gray-400">Sem riscos críticos identificados automaticamente neste período.</p>}
                  </div>
                </div>
                <div className="border border-emerald-100 rounded-lg p-4 bg-emerald-50">
                  <p className="text-emerald-700 font-bold text-xs uppercase tracking-wide mb-3">✓ Oportunidades</p>
                  <div className="space-y-2 text-sm text-gray-700">
                    {mrr > 0 && <p>• MRR de {formatCurrency(mrr)}/mês — base de receita recorrente estável</p>}
                    {yoyRec != null && yoyRec > 0 && <p>• Crescimento de receita de {formatPercent(yoyRec, 1)} vs {new Date().getFullYear() - 1}</p>}
                    {forecastPrec != null && forecastPrec >= 90 && <p>• Alta precisão de forecast ({formatPercent(forecastPrec, 1)}) — planejamento confiável</p>}
                    {takeRateMedio > 0 && <p>• Take Rate médio de {formatPercent(takeRateMedio, 3)} — espaço para otimização tarifária</p>}
                  </div>
                </div>
              </div>
            </div>

            <div className="border border-gray-200 rounded-lg p-4 bg-gray-50">
              <p className="text-gray-500 font-bold text-xs uppercase tracking-wide mb-2">Espaço para Comentários Executivos</p>
              <div className="min-h-16 border-b border-dashed border-gray-300" />
              <div className="min-h-12" />
            </div>
          </div>

          <div className="px-10 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
            <p className="text-xs text-gray-400">Bass Pago · RevenueOps · Documento Estritamente Confidencial</p>
            <p className="text-xs text-gray-400">Gerado em {dateStr}</p>
          </div>
        </div>
      </div>
    </>
  )
}
