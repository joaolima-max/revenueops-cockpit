  const yoyTpv = prevTotTpv > 0 ? ((totTpv - prevTotTpv) / prevTotTpv) * 100 : null

  const fwComp = forecasts.filter(f => f.faturamentoRealizado != null && (f.faturamentoPrevisto || 0) > 0)
  const forecastPrec = fwComp.length > 0 ? fwComp.reduce((s, f) => s + ((f.faturamentoRealizado! / (f.faturamentoPrevisto || 1)) * 100), 0) / fwComp.length : null

  const topClients = topClientsRaw.map(t => {
    const info = topClientData.find(c => c.id === t.clienteId)
    const receita = (t._sum.receitaTarifaria || 0) + (t._sum.floating || 0)
    return { ...t, nome: info?.nome || '—', segmento: info?.segmento, receita }
  }).sort((a, b) => b.receita - a.receita)

  const top3Share = totRec > 0 ? (topClients.slice(0, 3).reduce((s, t) => s + t.receita, 0) / totRec) * 100 : 0
