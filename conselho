  const ativos = statusGroup.find(g => g.status === 'ATIVO')?._count || 0
  const metasComRealizado = metas.filter(m => m.realizado != null)

  const last2 = monthlyProc.slice(-2)
  const momRec = last2.length === 2 && ((last2[0]._sum.receitaTarifaria || 0) + (last2[0]._sum.floating || 0)) > 0
    ? ((((last2[1]._sum.receitaTarifaria || 0) + (last2[1]._sum.floating || 0)) - ((last2[0]._sum.receitaTarifaria || 0) + (last2[0]._sum.floating || 0))) / ((last2[0]._sum.receitaTarifaria || 0) + (last2[0]._sum.floating || 0))) * 100
    : null
  const momTpv = last2.length === 2 && (last2[0]._sum.tpv || 0) > 0
