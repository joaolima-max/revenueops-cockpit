              <KpiBox label="TPV Total" value={formatTPV(totTpv)} sub={yoyTpv != null ? `${yoyTpv >= 0 ? '▲' : '▼'} ${Math.abs(yoyTpv).toFixed(1)}% vs ${currentYear - 1}` : undefined} />
