}

function KpiBox({ label, value, sub }: { label: string; value: string; sub?: string }) {
  return (
    <div className="border border-gray-200 rounded-lg p-4">
      <p className="text-gray-500 text-[10px] font-semibold uppercase tracking-widest mb-1.5">{label}</p>
      <p className="text-gray-900 text-2xl font-bold leading-none">{value}</p>
      {sub && <p className="text-gray-400 text-xs mt-1.5">{sub}</p>}
    </div>
  )
}

function MiniBar({ pct, color = '#10b981' }: { pct: number; color?: string }) {
  return (
    <div className="h-1.5 bg-gray-100 rounded-full flex-1">
      <div className="h-1.5 rounded-full" style={{ width: `${Math.min(pct, 100)}%`, background: color }} />
    </div>
  )
}

export default async function ConselhoPage() {
  const { monthlyProc, forecasts, metas, clientesAtivos, segmentoGroup, statusGroup, parametros, topClientsRaw, topClientData, prevYearProc, currentYear, startMonth } = await getData()

  const now = new Date()
  const dateStr = now.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
  const periodLabel = `${formatMesRef(startMonth)} – ${formatMesRef(`${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`)}`

  const totRec = monthlyProc.reduce((s, m) => s + (m._sum.receitaTarifaria || 0) + (m._sum.floating || 0), 0)
  const totTpv = monthlyProc.reduce((s, m) => s + (m._sum.tpv || 0), 0)
  const totTarifaria = monthlyProc.reduce((s, m) => s + (m._sum.receitaTarifaria || 0), 0)
  const totFloating = monthlyProc.reduce((s, m) => s + (m._sum.floating || 0), 0)
  const takeRateMedio = totTpv > 0 ? (totTarifaria / totTpv) * 100 : 0
  const mrr = clientesAtivos.reduce((s, c) => s + (c.mensalidadeApi || 0) + (c.sustentacaoWhiteLabel || 0), 0)

