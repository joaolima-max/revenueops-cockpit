async function getData() {
  const now = new Date()
  const d23 = new Date(now.getFullYear(), now.getMonth() - 23, 1)
  const start24 = `${d23.getFullYear()}-${String(d23.getMonth() + 1).padStart(2, '0')}`
  const d11 = new Date(now.getFullYear(), now.getMonth() - 11, 1)
  const start12 = `${d11.getFullYear()}-${String(d11.getMonth() + 1).padStart(2, '0')}`
  const prevYearStart = `${now.getFullYear() - 1}-01`
  const prevYearEnd = `${now.getFullYear() - 1}-12`
  const curYearStart = `${now.getFullYear()}-01`

  const [monthlyProc24, clientesAtivos, segmentoGroup, statusGroup, modeloGroup, forecasts, parametros] = await Promise.all([
    prisma.processamento.groupBy({
      by: ['mesRef'],
      _sum: { tpv: true, receitaTarifaria: true, floating: true, qtdTransacoes: true },
      where: { mesRef: { gte: start24 } },
      orderBy: { mesRef: 'asc' },
    }),
    prisma.cliente.findMany({
      where: { status: 'ATIVO' },
      select: { mensalidadeApi: true, sustentacaoWhiteLabel: true, segmento: true, modeloOperacional: true, dataFechamento: true },
    }),
    prisma.cliente.groupBy({
      by: ['segmento'],
      _count: { id: true },
      where: { status: 'ATIVO' },
    }),
    prisma.cliente.groupBy({
      by: ['status'],
      _count: { id: true },
    }),
    prisma.cliente.groupBy({
      by: ['modeloOperacional'],
      _count: { id: true },
      where: { status: 'ATIVO' },
    }),
    prisma.forecastGeral.findMany({
      where: { mesRef: { gte: start12 } },
      orderBy: { mesRef: 'asc' },
    }),
    prisma.parametro.findMany({ where: { chave: { in: ['CAC', 'LTV_MESES'] } } }),
  ])

  const topClientsRaw = await prisma.processamento.groupBy({
    by: ['clienteId'],
    _sum: { tpv: true, receitaTarifaria: true, floating: true },
    where: { mesRef: { gte: start12 } },
    orderBy: { _sum: { tpv: 'desc' } },
    take: 10,
  })
  const topIds = topClientsRaw.map(t => t.clienteId)
  const topClientData = topIds.length > 0 ? await prisma.cliente.findMany({
    where: { id: { in: topIds } },
    select: { id: true, nome: true, segmento: true, modeloOperacional: true, status: true },
  }) : []

  return { monthlyProc24, clientesAtivos, segmentoGroup, statusGroup, modeloGroup, forecasts, parametros, topClientsRaw, topClientData, start24, start12, prevYearStart, prevYearEnd, curYearStart }
}

