export const dynamic = 'force-dynamic'

import Link from 'next/link'
import { prisma } from '@/lib/prisma'
import PrintButton from '@/components/relatorios/PrintButton'
import { formatPercent, META_TIPO_LABELS } from '@/lib/utils'

const PRINT_CSS = `
@media print {
  aside, .no-print { display: none !important; }
  body { background: white !important; }
  .report-paper { box-shadow: none !important; max-width: none !important; border-radius: 0 !important; margin: 0 !important; }
  .report-wrap { background: white !important; padding: 0 !important; }
}
@page { size: A4; margin: 15mm 20mm; }
`

async function getData() {
  const metas = await prisma.meta.findMany({
    orderBy: [{ periodo: 'desc' }, { tipo: 'asc' }],
  })
  return { metas }
}

function Logo() {
  return (
    <div className="flex items-center gap-2.5">
      <div className="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style={{ background: 'linear-gradient(135deg, #10b981 0%, #0ea5e9 100%)' }}>
        <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2.5" strokeLinecap="round">
          <line x1="4" y1="4" x2="20" y2="20" /><line x1="20" y1="4" x2="4" y2="20" />
          <circle cx="12" cy="12" r="2.5" fill="white" stroke="none" />
        </svg>
      </div>
      <div>
        <p className="text-gray-900 font-bold text-base leading-none">Bass Pago</p>
        <p className="text-gray-400 text-xs mt-0.5">RevenueOps</p>
      </div>
    </div>
  )
}

function ProgressBar({ pct }: { pct: number }) {
  const color = pct >= 100 ? '#10b981' : pct >= 80 ? '#f59e0b' : pct >= 50 ? '#f97316' : '#ef4444'
  return (
    <div className="flex items-center gap-2">
      <div className="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
        <div className="h-2 rounded-full transition-all" style={{ width: `${Math.min(pct, 100)}%`, background: color }} />
      </div>
      <span className="text-xs font-bold w-12 text-right" style={{ color }}>{formatPercent(pct, 1)}</span>
    </div>
  )
}

export default async function MetasPage() {
  const { metas } = await getData()

  const now = new Date()
  const dateStr = now.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
  const currentYear = now.getFullYear()

  const byPeriodo: Record<string, typeof metas> = {}
  metas.forEach(m => {
    if (!byPeriodo[m.periodo]) byPeriodo[m.periodo] = []
    byPeriodo[m.periodo].push(m)
  })

  const periodos = Object.keys(byPeriodo).sort().reverse()

  const metasComRealizado = metas.filter(m => m.realizado != null)
  const atingidas = metasComRealizado.filter(m => m.realizado! >= m.valor)
  const abaixo80 = metasComRealizado.filter(m => m.realizado! < m.valor * 0.8)
  const mediaAtingimento = metasComRealizado.length > 0
    ? metasComRealizado.reduce((s, m) => s + (m.realizado! / m.valor) * 100, 0) / metasComRealizado.length
    : null

  const sorted = [...metasComRealizado].sort((a, b) => (b.realizado! / b.valor) - (a.realizado! / a.valor))
  const best = sorted[0]
  const worst = sorted[sorted.length - 1]

  return (
    <>
      <style>{PRINT_CSS}</style>
      <div className="report-wrap min-h-screen bg-gray-100 py-8 px-6">
        <div className="no-print max-w-4xl mx-auto mb-5 flex items-center justify-between">
          <Link href="/dashboard/relatorios" className="text-gray-500 hover:text-gray-800 text-sm flex items-center gap-1.5 transition-colors">← Relatórios</Link>
          <PrintButton label="Exportar PDF" />
        </div>

        <div className="report-paper max-w-4xl mx-auto bg-white shadow-2xl rounded-2xl overflow-hidden">
          <div className="h-2" style={{ background: 'linear-gradient(135deg, #f59e0b 0%, #ea580c 100%)' }} />

          <div className="p-10">
            <div className="flex items-start justify-between mb-8 pb-6 border-b-2 border-gray-100">
              <Logo />
              <div className="text-right">
                <h1 className="text-2xl font-bold text-gray-900">Relatório de Metas</h1>
                <p className="text-gray-500 text-sm mt-1">Todos os períodos · Gestão / Board</p>
                <p className="text-gray-400 text-xs mt-0.5">Gerado em {dateStr}</p>
              </div>
            </div>

            {metasComRealizado.length > 0 && (
              <>
                <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Resumo de Atingimento</h2>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                  <div className="border border-gray-200 rounded-lg p-4 text-center">
                    <p className="text-[10px] text-gray-500 font-semibold uppercase tracking-wide mb-2">Média Geral</p>
                    <p className={`text-2xl font-bold ${mediaAtingimento != null ? (mediaAtingimento >= 100 ? 'text-emerald-600' : mediaAtingimento >= 80 ? 'text-amber-500' : 'text-red-500') : 'text-gray-900'}`}>
                      {mediaAtingimento != null ? formatPercent(mediaAtingimento, 1) : '—'}
                    </p>
                  </div>
                  <div className="border border-emerald-200 bg-emerald-50 rounded-lg p-4 text-center">
                    <p className="text-[10px] text-emerald-700 font-semibold uppercase tracking-wide mb-2">Atingidas</p>
                    <p className="text-2xl font-bold text-emerald-600">{atingidas.length}</p>
                    <p className="text-xs text-emerald-600 mt-1">de {metasComRealizado.length} avaliadas</p>
                  </div>
                  <div className="border border-red-200 bg-red-50 rounded-lg p-4 text-center">
                    <p className="text-[10px] text-red-600 font-semibold uppercase tracking-wide mb-2">Abaixo de 80%</p>
                    <p className="text-2xl font-bold text-red-500">{abaixo80.length}</p>
                    <p className="text-xs text-red-500 mt-1">requerem atenção</p>
                  </div>
                  <div className="border border-gray-200 rounded-lg p-4 text-center">
                    <p className="text-[10px] text-gray-500 font-semibold uppercase tracking-wide mb-2">Sem Dados</p>
                    <p className="text-2xl font-bold text-gray-400">{metas.length - metasComRealizado.length}</p>
                    <p className="text-xs text-gray-400 mt-1">sem realizado lançado</p>
                  </div>
                </div>

                {(best || worst) && (
                  <div className="grid grid-cols-2 gap-4 mb-10">
                    {best && (
                      <div className="border border-emerald-200 bg-emerald-50 rounded-lg p-4">
                        <p className="text-[10px] text-emerald-700 font-semibold uppercase tracking-wide mb-1">Melhor Desempenho</p>
                        <p className="text-gray-900 font-bold">{META_TIPO_LABELS[best.tipo] || best.tipo}</p>
                        <p className="text-gray-500 text-xs">{best.periodo}</p>
                        <p className="text-emerald-600 font-bold text-lg mt-2">{formatPercent((best.realizado! / best.valor) * 100, 1)}</p>
                      </div>
                    )}
                    {worst && worst.id !== best?.id && (
                      <div className="border border-red-200 bg-red-50 rounded-lg p-4">
                        <p className="text-[10px] text-red-600 font-semibold uppercase tracking-wide mb-1">Atenção</p>
                        <p className="text-gray-900 font-bold">{META_TIPO_LABELS[worst.tipo] || worst.tipo}</p>
                        <p className="text-gray-500 text-xs">{worst.periodo}</p>
                        <p className="text-red-500 font-bold text-lg mt-2">{formatPercent((worst.realizado! / worst.valor) * 100, 1)}</p>
                      </div>
                    )}
                  </div>
                )}
              </>
            )}

            {metas.length === 0 ? (
              <div className="text-center py-16 text-gray-400">
                <p className="text-lg font-medium">Nenhuma meta cadastrada</p>
                <p className="text-sm mt-2">Cadastre metas em Receita → Metas</p>
              </div>
            ) : (
              periodos.map(periodo => (
                <div key={periodo} className="mb-10">
                  <h2 className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4 flex items-center gap-3">
                    Período: {periodo}
                    {periodo.startsWith(String(currentYear)) && (
                      <span className="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 text-[10px] font-bold">ANO ATUAL</span>
                    )}
                  </h2>
                  <table className="w-full text-sm border-collapse">
                    <thead>
                      <tr className="border-b-2 border-gray-200">
                        {['Indicador', 'Meta', 'Realizado', 'Gap', 'Atingimento', 'Progresso', 'Status'].map(h => (
                          <th key={h} className={`text-xs text-gray-500 font-semibold py-2 ${h === 'Indicador' ? 'text-left' : h === 'Progresso' ? 'text-left' : 'text-right'}`}>{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {byPeriodo[periodo].map(m => {
                        const pct = m.realizado != null && m.valor > 0 ? (m.realizado / m.valor) * 100 : null
                        const gap = m.realizado != null ? m.realizado - m.valor : null
                        const status = pct == null ? 'Aguardando' : pct >= 100 ? 'Atingida' : pct >= 80 ? 'Em progresso' : 'Abaixo'
                        const statusColor = pct == null ? 'bg-gray-100 text-gray-500' : pct >= 100 ? 'bg-emerald-100 text-emerald-700' : pct >= 80 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'
                        return (
                          <tr key={m.id} className="border-b border-gray-100">
                            <td className="py-3 text-gray-900 font-semibold">{META_TIPO_LABELS[m.tipo] || m.tipo}</td>
                            <td className="py-3 text-right text-gray-700 font-medium">{m.valor.toLocaleString('pt-BR')}</td>
                            <td className="py-3 text-right text-gray-900 font-semibold">{m.realizado != null ? m.realizado.toLocaleString('pt-BR') : '—'}</td>
                            <td className={`py-3 text-right font-semibold ${gap == null ? 'text-gray-400' : gap >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                              {gap != null ? (gap >= 0 ? '+' : '') + gap.toLocaleString('pt-BR') : '—'}
                            </td>
                            <td className={`py-3 text-right font-bold text-base ${pct == null ? 'text-gray-400' : pct >= 100 ? 'text-emerald-600' : pct >= 80 ? 'text-amber-500' : 'text-red-500'}`}>
                              {pct != null ? formatPercent(pct, 1) : '—'}
                            </td>
                            <td className="py-3 pl-4 min-w-[120px]">
                              {pct != null ? <ProgressBar pct={pct} /> : <span className="text-gray-400 text-xs">—</span>}
                            </td>
                            <td className="py-3 text-right">
                              <span className={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${statusColor}`}>{status}</span>
                            </td>
                          </tr>
                        )
                      })}
                    </tbody>
                  </table>

                  {periodo.startsWith(String(currentYear)) && (
                    <div className="mt-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                      <p className="text-xs text-gray-500">
                        {byPeriodo[periodo].filter(m => m.realizado != null && m.realizado < m.valor).length} meta(s) ainda não atingidas ·{' '}
                        {byPeriodo[periodo].filter(m => m.realizado == null).length} meta(s) aguardando lançamento do realizado
                      </p>
                    </div>
                  )}
                </div>
              ))
            )}

            {metasComRealizado.length >= 3 && (
              <div className="mt-4 border border-gray-200 rounded-lg p-4">
                <p className="text-xs font-bold text-gray-400 tracking-widest uppercase mb-4">Histórico de Atingimento por Indicador</p>
                {(() => {
                  const byTipo: Record<string, typeof metas> = {}
                  metasComRealizado.forEach(m => {
                    if (!byTipo[m.tipo]) byTipo[m.tipo] = []
                    byTipo[m.tipo].push(m)
                  })
                  return Object.entries(byTipo).filter(([, ms]) => ms.length >= 2).map(([tipo, ms]) => {
                    const avg = ms.reduce((s, m) => s + (m.realizado! / m.valor) * 100, 0) / ms.length
                    return (
                      <div key={tipo} className="mb-4">
                        <div className="flex items-center justify-between mb-2">
                          <span className="text-sm font-semibold text-gray-700">{META_TIPO_LABELS[tipo] || tipo}</span>
                          <span className="text-xs text-gray-500">Média: <span className={`font-bold ${avg >= 100 ? 'text-emerald-600' : avg >= 80 ? 'text-amber-500' : 'text-red-500'}`}>{formatPercent(avg, 1)}</span></span>
                        </div>
                        <div className="flex gap-1">
                          {ms.sort((a, b) => a.periodo.localeCompare(b.periodo)).map(m => {
                            const pct = (m.realizado! / m.valor) * 100
                            const color = pct >= 100 ? '#10b981' : pct >= 80 ? '#f59e0b' : '#ef4444'
                            return (
                              <div key={m.id} className="flex-1 text-center">
                                <div className="h-12 bg-gray-100 rounded flex items-end overflow-hidden">
                                  <div className="w-full rounded" style={{ height: `${Math.min(pct, 120)}%`, background: color, opacity: 0.7 }} />
                                </div>
                                <p className="text-[9px] text-gray-400 mt-1">{m.periodo}</p>
                              </div>
                            )
                          })}
                        </div>
                      </div>
                    )
                  })
                })()}
              </div>
            )}
          </div>

          <div className="px-10 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-between">
            <p className="text-xs text-gray-400">Bass Pago · RevenueOps · Relatório de Metas — Gestão / Board</p>
            <p className="text-xs text-gray-400">Gerado em {dateStr}</p>
          </div>
        </div>
      </div>
    </>
  )
}
