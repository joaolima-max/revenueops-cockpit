generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERACIONAL
  COMERCIAL
}

enum LeadStatus {
  NOVO
  QUALIFICADO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum DealStage {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  FECHAMENTO
  GANHO
  PERDIDO
}

enum ModeloOperacional {
  API
  WHITE_LABEL
  BAAS
}

enum ClienteStatus {
  ATIVO
  INATIVO
  PROSPECCAO
  ENCERRADO
}

enum MetaTipo {
  RECEITA_TARIFARIA
  TPV
  SALDO_EM_CONTA
  TRANSACOES
  MEDS

  // Legado: metas criadas antes da revisao da taxonomia ainda usam estes
  // valores em Production. Mantidos para o client conseguir le-las; nao sao
  // oferecidos na criacao de novas metas.
  RECEITA
  MRR
  CLIENTES_ATIVOS
}

enum Segmento {
  IGAMING
  ECOMMERCE
  SAAS
  ERP
  TELECOM
  CRIPTOMOEDAS
  VAREJO
  OUTROS
}

enum OperacaoCom {
  CASH_IN
  CASH_OUT
  BAAS
  WHITE_LABEL
}

enum ScoreRisco {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TarefaPrioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum IncidenteCriticidade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}


model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COMERCIAL)
  active    Boolean  @default(true)
  avatar     String?
  permissoes String?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads          Lead[]          @relation("LeadOwner")
  deals          Deal[]          @relation("DealOwner")
  activities     Activity[]
  clientes       Cliente[]
  tarefasCriadas Tarefa[]        @relation("TarefaCriador")
  tarefasAssign  Tarefa[]        @relation("TarefaResponsavel")
  auditorias     Auditoria[]
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  position  String?
  source    String?
  status    LeadStatus @default(NOVO)
  value     Float?
  notes     String?
  segmento  Segmento?
  operacao  OperacaoCom?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  ownerId    String
  owner      User       @relation("LeadOwner", fields: [ownerId], references: [id])
  deals      Deal[]
  activities Activity[]
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  value       Float
  stage       DealStage @default(PROSPECCAO)
  probability Int       @default(0)
  notes       String?
  expectedAt  DateTime?
  closedAt    DateTime?
  segmento    Segmento?
  operacao    OperacaoCom?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId    String
  owner      User       @relation("DealOwner", fields: [ownerId], references: [id])
  leadId     String?
  lead       Lead?      @relation(fields: [leadId], references: [id])
  activities Activity[]
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  leadId String?
  lead   Lead?  @relation(fields: [leadId], references: [id])
  dealId String?
  deal   Deal?  @relation(fields: [dealId], references: [id])
}

model Cliente {
  id                    String            @id @default(cuid())
  nome                  String
  cnpj                  String?
  email                 String?
  telefone              String?
  modeloOperacional     ModeloOperacional
  status                ClienteStatus     @default(PROSPECCAO)
  segmento              Segmento?
  operacao              OperacaoCom?
  scoreRisco            ScoreRisco?
  dataFechamento        DateTime?
  dataEncerramento      DateTime?
  mensalidadeApi        Float?
  sustentacaoWhiteLabel Float?
  setup                 Float?
  tpvEsperado           Float?
  qtdTransacoesEsperada Int?
  qtdMedEsperada        Int?
  receitaPrevistaMensal Float?
  descontoPercent       Float?
  overpricePercent      Float?
  notas                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])
  tarefas        Tarefa[]
  contasReceber  ContaReceber[]
  followUps      FollowUp[]
}




model Meta {
  id        String   @id @default(cuid())
  tipo      MetaTipo
  valor     Float
  periodo   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, periodo])
}

model Tarefa {
  id          String           @id @default(cuid())
  titulo      String
  descricao   String?
  status      TarefaStatus     @default(PENDENTE)
  prioridade  TarefaPrioridade @default(MEDIA)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  clienteId      String?
  cliente        Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  criadoPorId    String
  criadoPor      User     @relation("TarefaCriador", fields: [criadoPorId], references: [id])
  responsavelId  String
  responsavel    User     @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
}

model Incidente {
  id           String              @id @default(cuid())
  titulo       String
  descricao    String?
  inicio       DateTime
  fim          DateTime?
  downtimeMins Int?
  criticidade  IncidenteCriticidade @default(MEDIA)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

}



enum ContaReceberStatus {
  PENDENTE
  FATURADO
  PAGO
  INADIMPLENTE
}

enum FollowUpTipo {
  PICO_OPERACIONAL
  REUNIAO
  MONITORAMENTO
  FOLLOW_UP
  ALERTA
  OUTRO
}

model Auditoria {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Parametro {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     String
  label     String
  descricao String?
  grupo     String   @default("GERAL")
  tipo      String   @default("NUMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ContaReceber {
  id          String             @id @default(cuid())
  descricao   String
  tipo        String
  valor       Float
  parcela     Int?
  totalParcel Int?
  dataVenc    DateTime
  dataFatura  DateTime?
  dataPago    DateTime?
  status      ContaReceberStatus @default(PENDENTE)
  notas       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  clienteId   String
  cliente     Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id          String       @id @default(cuid())
  titulo      String
  descricao   String?
  tipo        FollowUpTipo @default(FOLLOW_UP)
  recorrente  Boolean      @default(false)
  diaSemana   Int?
  horaInicio  String?
  horaFim     String?
  dataInicio  DateTime?
  dataFim     DateTime?
  notas           String?
  frequenciaDias  Int?
  ultimoContato   DateTime?
  proximoContato  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  clienteId       String
  cliente         Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

/// FONTE OFICIAL dos 5 indicadores realizados. Grão: uma data.
/// Nenhum outro modelo grava TPV, receita tarifária, saldo, transações ou MEDs.
model LancamentoDiario {
  id               String   @id @default(cuid())
  data             DateTime @unique @db.Date
  receitaTarifaria Float    @default(0)
  tpv              Float    @default(0)
  saldoEmConta     Float    @default(0)
  qtdTransacoes    Int      @default(0)
  qtdMed           Int      @default(0)
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([data])
}

/// Multiplicador do Float, configuravel pela tela de Parametros.
/// Versionado por vigencia para que periodos fechados nao mudem de valor
/// quando o multiplicador for alterado.
model FloatConfig {
  id             String   @id @default(cuid())
  multiplicador  Float
  vigenciaInicio DateTime @unique @db.Date
  notas          String?
  createdAt      DateTime @default(now())
}

/// Volumetria minima CONTRATADA GERAL da empresa por periodo (YYYY-MM).
/// O realizado vem de LancamentoDiario; o atingimento e derivado, nunca gravado.
model VolumetriaMinima {
  id        String   @id @default(cuid())
  periodo   String   @unique
  qtdMinima Int
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
