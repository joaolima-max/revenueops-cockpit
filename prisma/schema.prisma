generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERACIONAL
  COMERCIAL
  /// Gestor de carteira. Entra ao lado de COMERCIAL, que permanece porque ha
  /// usuarios em Production com ela e o seed do funil de Vendas a referencia.
  GESTOR
}

enum LeadStatus {
  NOVO
  QUALIFICADO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum DealStage {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  FECHAMENTO
  GANHO
  PERDIDO
}

enum ModeloOperacional {
  API
  WHITE_LABEL
  BAAS
}

enum ClienteStatus {
  ATIVO
  INATIVO
  PROSPECCAO
  ENCERRADO
  STANDBY
}

enum MetaTipo {
  RECEITA_TARIFARIA
  TPV
  SALDO_EM_CONTA
  TRANSACOES
  MEDS

  // Legado: metas criadas antes da revisao da taxonomia ainda usam estes
  // valores em Production. Mantidos para o client conseguir le-las; nao sao
  // oferecidos na criacao de novas metas.
  RECEITA
  MRR
  CLIENTES_ATIVOS
}

/// Taxonomia comercial. Os quatro primeiros valores sao os da revisao atual;
/// os demais sao legado e continuam sendo lidos, mas nao sao mais oferecidos
/// na criacao de Leads.
enum Segmento {
  CRYPTO_EXCHANGES
  REMESSA_FX
  GATEWAY_PAGAMENTOS
  BAAS

  TELECOM
  ERP
  IGAMING
  SAAS

  ECOMMERCE
  CRIPTOMOEDAS
  VAREJO
  OUTROS
}

enum Canal {
  OUTBOUND
  INDICACAO
  INBOUND
  EVENTOS
  OUTRO
}

enum OperacaoCom {
  CASH_IN
  CASH_OUT
  BAAS
  WHITE_LABEL
}

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TarefaPrioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum IncidenteCriticidade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

/// Comportamento da etapa. GANHO e PERDIDO encerram o card: saem das colunas
/// ativas do quadro e gravam `closedAt` no Deal.
enum EtapaTipo {
  NORMAL
  GANHO
  PERDIDO
}

enum MovimentacaoTipo {
  CRIACAO
  MOVIMENTO_ETAPA
  TRANSFERENCIA_FUNIL
}

enum NotificacaoOrigem {
  PIPELINE
  AUTOMACAO
  COMPLIANCE
  FORMULARIO
  CERTIFICADO
  SISTEMA
}

enum DocumentoCategoria {
  CONTRATO
  KYC_KYB
  CERTIFICADO
  COMPROVANTE
  COMERCIAL
  FINANCEIRO
  OUTROS
}

/// FORMULARIO permanece: o ambiente saiu do produto, mas ha documentos
/// historicos gravados com essa origem e reescrever o passado nao e opcao.
enum DocumentoOrigem {
  UPLOAD_MANUAL
  CERTIFICADO
  FORMULARIO
  COMPLIANCE
  LANCAMENTO_FINANCEIRO
}

enum CertificadoVersaoStatus {
  ATIVA
  ESGOTADA
  SUBSTITUIDA
  CANCELADA
}

enum CertificadoStatus {
  DISPONIVEL
  ENVIADO
  REVOGADO
  EXPIRADO
}

enum CertificadoEnvioTipo {
  UNICO
  LOTE
}

enum CertificadoEnvioStatus {
  ENVIADO
  CANCELADO
}

enum PendenciaMotivo {
  ATUALIZACAO_CADASTRAL
  EXPLICACAO_MOVIMENTACAO
  EXPLICACAO_DENUNCIA
  REGULARIZACAO_DOCUMENTO
  OUTRO
}

enum PendenciaStatus {
  ABERTA
  EM_ANALISE
  AGUARDANDO_CLIENTE
  RESOLVIDA
  CANCELADA
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(COMERCIAL)
  active     Boolean  @default(true)
  avatar     String?
  permissoes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leads              Lead[]                 @relation("LeadOwner")
  deals              Deal[]                 @relation("DealOwner")
  activities         Activity[]
  clientes           Cliente[]
  tarefasCriadas     Tarefa[]               @relation("TarefaCriador")
  tarefasAssign      Tarefa[]               @relation("TarefaResponsavel")
  auditorias         Auditoria[]
  pipelinePermissoes PipelinePermissao[]
  movimentacoes      PipelineMovimentacao[]

  clientesGeridos    Cliente[]                    @relation("ClienteGestor")
  notificacoes       Notificacao[]
  documentos         Documento[]
  diasRegistrados    ClienteDiaMovimento[]
  versoesCriadas     CertificadoVersao[]
  enviosCertificado  CertificadoEnvio[]
  pendencias         PendenciaCompliance[]        @relation("PendenciaResponsavel")
  pendenciaEventos   PendenciaEvento[]
  comentariosLead    LeadComentario[]
  lancamentos        LancamentoFinanceiro[]       @relation("LancamentoCriador")
  condicoesHistorico CondicaoComercialHistorico[] @relation("CondicaoHistoricoAutor")
}

model Lead {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  position  String?
  source    String?
  status    LeadStatus   @default(NOVO)
  notes     String?
  segmento  Segmento?
  operacao  OperacaoCom?
  /// Cadastro revisado (CRM): CNPJ e canal de origem.
  cnpj      String?
  canal     Canal?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  ownerId     String
  owner       User             @relation("LeadOwner", fields: [ownerId], references: [id])
  deals       Deal[]
  activities  Activity[]
  comentarios LeadComentario[]
}

/// Comentario de Lead com autor e data/hora. Separado de `Lead.notes`, que e o
/// campo de observacoes livre do cadastro.
model LeadComentario {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])
  texto     String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Deal {
  id          String       @id @default(cuid())
  title       String
  value       Float
  stage       DealStage    @default(PROSPECCAO)
  probability Int          @default(0)
  notes       String?
  expectedAt  DateTime?
  closedAt    DateTime?
  segmento    Segmento?
  operacao    OperacaoCom?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ownerId    String
  owner      User       @relation("DealOwner", fields: [ownerId], references: [id])
  leadId     String?
  lead       Lead?      @relation(fields: [leadId], references: [id])
  activities Activity[]

  /// Funil e etapa em que o card esta AGORA. Nulos apenas ate o backfill da
  /// migration v11 rodar; depois disso todo Deal mora em algum funil.
  funilId   String?
  funil     PipelineFunil? @relation(fields: [funilId], references: [id], onDelete: Restrict)
  etapaId   String?
  etapa     PipelineEtapa? @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  /// Preenchido quando o card passa para um funil de pos-venda.
  clienteId String?
  cliente   Cliente?       @relation(fields: [clienteId], references: [id])

  movimentacoes PipelineMovimentacao[]

  @@index([funilId, etapaId])
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  createdAt   DateTime @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id])
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])
}

/// CADASTRO COMERCIAL DO CLIENTE — so o que o produto realmente usa.
///
/// Os campos financeiros de expectativa que existiam aqui (TPV esperado,
/// receita prevista, desconto, overprice, setup, sustentacao de White Label,
/// quantidades esperadas) sairam do cadastro: nenhum deles era a fonte de
/// verdade de nada. O realizado vem de LancamentoDiario, as condicoes
/// comerciais de BaaS/White Label vem de CondicaoComercial, e o minimo
/// contratual de transacoes vem de VolumetriaMinima.
///
/// `mensalidadeApi` PERMANECE porque e uma das quatro parcelas do MRR
/// (ver lib/financeiro.ts): a mensalidade de API dos clientes da carteira.
model Cliente {
  id                String            @id @default(cuid())
  nome              String
  cnpj              String?
  email             String?
  telefone          String?
  modeloOperacional ModeloOperacional
  status            ClienteStatus     @default(PROSPECCAO)
  segmento          Segmento?
  dataFechamento    DateTime?
  dataEncerramento  DateTime?
  mensalidadeApi    Float?
  notas             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ownerId           String
  owner             User                  @relation(fields: [ownerId], references: [id])
  /// Gestor responsavel pela carteira. Nulo nos clientes anteriores a v12.
  /// NAO substitui `ownerId`, que segue como vinculo legado.
  gestorId          String?
  gestor            User?                 @relation("ClienteGestor", fields: [gestorId], references: [id])
  tarefas           Tarefa[]
  contasReceber     ContaReceber[]
  followUps         FollowUp[]
  volumetrias       VolumetriaMinima[]
  deals             Deal[]
  documentos        Documento[]
  diasMovimento     ClienteDiaMovimento[]
  enviosCertificado CertificadoEnvio[]
  pendencias        PendenciaCompliance[]

  @@index([gestorId])
}

model Meta {
  id        String   @id @default(cuid())
  tipo      MetaTipo
  valor     Float
  periodo   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, periodo])
}

model Tarefa {
  id         String           @id @default(cuid())
  titulo     String
  descricao  String?
  status     TarefaStatus     @default(PENDENTE)
  prioridade TarefaPrioridade @default(MEDIA)
  dueDate    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  criadoPorId   String
  criadoPor     User     @relation("TarefaCriador", fields: [criadoPorId], references: [id])
  responsavelId String
  responsavel   User     @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
}

model Incidente {
  id           String               @id @default(cuid())
  titulo       String
  descricao    String?
  inicio       DateTime
  fim          DateTime?
  downtimeMins Int?
  criticidade  IncidenteCriticidade @default(MEDIA)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

enum ContaReceberStatus {
  PENDENTE
  FATURADO
  PAGO
  INADIMPLENTE
}

enum FollowUpTipo {
  /// Pico transacional do cliente. Era PICO_OPERACIONAL; renomeado sem perda
  /// de dado (ALTER TYPE ... RENAME VALUE) para casar com a nomenclatura de
  /// produto, que nao usa mais "frequencia" como conceito principal.
  PICO_TRANSACIONAL
  REUNIAO
  MONITORAMENTO
  FOLLOW_UP
  ALERTA
  OUTRO
}

model Auditoria {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model ContaReceber {
  id          String             @id @default(cuid())
  descricao   String
  tipo        String
  valor       Float
  parcela     Int?
  totalParcel Int?
  dataVenc    DateTime
  dataFatura  DateTime?
  dataPago    DateTime?
  status      ContaReceberStatus @default(PENDENTE)
  notas       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  clienteId   String
  cliente     Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id                String       @id @default(cuid())
  titulo            String
  descricao         String?
  tipo              FollowUpTipo @default(FOLLOW_UP)
  recorrente        Boolean      @default(false)
  diaSemana         Int?
  horaInicio        String?
  horaFim           String?
  dataInicio        DateTime?
  dataFim           DateTime?
  notas             String?
  /// Intervalo em dias entre picos transacionais esperados do cliente.
  /// Mesma mecanica da antiga "frequencia de follow up" (coluna renomeada,
  /// dado preservado): nao existe um segundo sistema de recorrencia.
  picoIntervaloDias Int?
  ultimoContato     DateTime?
  proximoContato    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  clienteId         String
  cliente           Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

/// FONTE OFICIAL dos 5 indicadores realizados. Grão: uma data.
/// Nenhum outro modelo grava TPV, receita tarifária, saldo, transações ou MEDs.
model LancamentoDiario {
  id               String   @id @default(cuid())
  data             DateTime @unique @db.Date
  receitaTarifaria Float    @default(0)
  tpv              Float    @default(0)
  saldoEmConta     Float    @default(0)
  qtdTransacoes    Int      @default(0)
  qtdMed           Int      @default(0)
  /// Clientes ativos — FOTOGRAFIA DO DIA, na mesma convencao de `saldoEmConta`:
  /// e um estoque observado naquela data, nao um fluxo que se acumula. O numero
  /// mensal e portanto o do ULTIMO dia lancado do mes, nunca a soma dos dias.
  /// Nulo = nao informado naquele dia (distinto de zero cliente ativo).
  clientesAtivos   Int?
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([data])
}

/// Multiplicador do Float, configuravel pela tela de Parametros.
/// Versionado por vigencia para que periodos fechados nao mudem de valor
/// quando o multiplicador for alterado.
model FloatConfig {
  id             String   @id @default(cuid())
  multiplicador  Float
  vigenciaInicio DateTime @unique @db.Date
  notas          String?
  createdAt      DateTime @default(now())
}

/// Exigencia CONTRATUAL de quantidade minima de transacoes de UM cliente,
/// vigente de `periodo` (YYYY-MM, inicio) ate `vigenciaFim` (inclusive) ou por
/// prazo indeterminado.
///
/// Nao e TPV nem realizado por cliente: o realizado continua vindo, sempre e
/// somente, de LancamentoDiario, que e global por data. O minimo consolidado
/// de um mes e a SOMA dos contratos vigentes naquele mes.
///
/// Linhas com `clienteId` nulo sao contratos GERAIS legados, anteriores a
/// vinculacao por cliente. Preservadas para leitura e para que os alertas de
/// meses ja fechados nao mudem de resultado; a aplicacao nao cria mais linhas
/// assim.
model VolumetriaMinima {
  id          String   @id @default(cuid())
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Inicio da vigencia, "YYYY-MM". Mantem o nome original da coluna.
  periodo     String
  /// Fim da vigencia, "YYYY-MM" inclusive. Nulo = prazo indeterminado.
  vigenciaFim String?
  qtdMinima   Int
  ativo       Boolean  @default(true)
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clienteId, periodo])
  @@index([clienteId, ativo])
}

/// PIPELINE MULTI-FUNIL
///
/// O card NAO e um modelo novo: e o proprio Deal, que ganhou funilId/etapaId.
/// Um unico Deal atravessa Vendas -> Onboarding -> Operacoes, e por isso lead,
/// cliente, dono e atividades continuam associados sem nenhuma copia.

model PipelineFunil {
  id           String   @id @default(cuid())
  nome         String   @unique
  descricao    String?
  /// Area/departamento dono do funil. Rotulo descritivo: quem pode o que fica
  /// em PipelinePermissao, nao aqui.
  area         String?
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  /// Funis de pos-venda exigem um Cliente vinculado ao receber o card.
  exigeCliente Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  etapas     PipelineEtapa[]
  permissoes PipelinePermissao[]
  deals      Deal[]
  movOrigem  PipelineMovimentacao[] @relation("MovFunilOrigem")
  movDestino PipelineMovimentacao[] @relation("MovFunilDestino")

  @@index([ativo, ordem])
}

model PipelineEtapa {
  id        String        @id @default(cuid())
  funilId   String
  funil     PipelineFunil @relation(fields: [funilId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  /// Posicao da coluna. Indice NAO unico de proposito: um unique quebraria
  /// qualquer troca de posicao entre duas etapas.
  ordem     Int           @default(0)
  cor       String?
  ativo     Boolean       @default(true)
  tipo      EtapaTipo     @default(NORMAL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deals      Deal[]
  movOrigem  PipelineMovimentacao[] @relation("MovEtapaOrigem")
  movDestino PipelineMovimentacao[] @relation("MovEtapaDestino")

  @@unique([funilId, nome])
  @@index([funilId, ordem])
}

/// Alcada de UM funil para UMA role ou UM usuario — nunca os dois na mesma
/// linha. Nao substitui o sistema de permissoes: refina, dentro do modulo,
/// o que `view_pipeline`/`manage_pipeline` ja liberaram.
model PipelinePermissao {
  id      String        @id @default(cuid())
  funilId String
  funil   PipelineFunil @relation(fields: [funilId], references: [id], onDelete: Cascade)
  role    Role?
  userId  String?
  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  ver            Boolean @default(true)
  editar         Boolean @default(false)
  mover          Boolean @default(false)
  criar          Boolean @default(false)
  transferir     Boolean @default(false)
  administrar    Boolean @default(false)
  /// Preserva a regra que hoje esta embutida no codigo: o COMERCIAL so
  /// enxerga os proprios negocios.
  apenasProprios Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funilId, role])
  @@unique([funilId, userId])
  @@index([funilId])
}

/// Historico do card. Coexiste com Auditoria: o `detalhes` da Auditoria e
/// texto livre e nao permite montar uma linha do tempo com origem e destino,
/// nem filtrar por funil.
model PipelineMovimentacao {
  id     String           @id @default(cuid())
  dealId String
  deal   Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tipo   MovimentacaoTipo

  funilOrigemId  String?
  funilOrigem    PipelineFunil? @relation("MovFunilOrigem", fields: [funilOrigemId], references: [id], onDelete: Restrict)
  etapaOrigemId  String?
  etapaOrigem    PipelineEtapa? @relation("MovEtapaOrigem", fields: [etapaOrigemId], references: [id], onDelete: Restrict)
  funilDestinoId String
  funilDestino   PipelineFunil  @relation("MovFunilDestino", fields: [funilDestinoId], references: [id])
  etapaDestinoId String
  etapaDestino   PipelineEtapa  @relation("MovEtapaDestino", fields: [etapaDestinoId], references: [id])

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  observacao String?
  createdAt  DateTime @default(now())

  @@index([dealId, createdAt])
  @@index([funilDestinoId, createdAt])
}

// ===========================================================================
// FUNDACAO — Notificacoes, Documentos e movimento diario do cliente (v12)
// ===========================================================================

/// Mensagem dirigida a UM usuario. Nao se confunde com o mecanismo de Alertas,
/// que e operacional e derivado; notificacao tem destinatario, leitura e
/// contexto para onde voltar.
///
/// Nao tem chave de permissao: cada usuario ve as suas, filtradas por
/// `destinatarioId`. Uma chave aqui so criaria a chance de configurar errado.
model Notificacao {
  id             String            @id @default(cuid())
  destinatarioId String
  destinatario   User              @relation(fields: [destinatarioId], references: [id], onDelete: Cascade)
  titulo         String
  mensagem       String
  origem         NotificacaoOrigem @default(SISTEMA)
  /// Contexto polimorfico leve: aponta para sete modelos diferentes, entao nao
  /// ha FK. `href` e o link que a central abre.
  entidade       String?
  entidadeId     String?
  href           String?
  lidaEm         DateTime?
  createdAt      DateTime          @default(now())

  @@index([destinatarioId, lidaEm])
  @@index([destinatarioId, createdAt])
}

/// Metadados do arquivo. Os bytes vivem no Supabase Storage, bucket privado
/// `cliente-arquivos`; aqui fica so a chave. Download sempre por signed URL de
/// curta duracao, emitida por rota que checa permissao e grava Auditoria.
model Documento {
  id           String             @id @default(cuid())
  /// Nulo quando o arquivo nao pertence a um cliente — o caso do anexo de
  /// lancamento financeiro (nota fiscal, comprovante) e do ZIP de
  /// certificados, que e estoque global. Era obrigatorio porque o unico
  /// caminho de upload era o ambiente "Documentos", que saiu do produto.
  clienteId    String?
  cliente      Cliente?           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome         String
  categoria    DocumentoCategoria @default(OUTROS)
  origem       DocumentoOrigem    @default(UPLOAD_MANUAL)
  mime         String
  tamanho      Int
  /// Caminho no bucket. Nunca uma URL publica.
  storageKey   String             @unique
  descricao    String?
  ativo        Boolean            @default(true)
  enviadoPorId String
  enviadoPor   User               @relation(fields: [enviadoPorId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  certificadoVersao CertificadoVersao?
  /// Anexo de um lancamento financeiro (nota fiscal, comprovante, print).
  anexoLancamento   LancamentoAnexo?

  @@index([clienteId, ativo])
  @@index([categoria])
}

/// Indicador operacional diario: o cliente movimentou conosco naquele dia?
///
/// NAO e TPV por cliente e NAO guarda valor nenhum — so o booleano. A ausencia
/// de linha significa "sem registro", o que da tres estados com um unico campo
/// e evita que um dia nao preenchido vire um "nao" falso.
model ClienteDiaMovimento {
  id              String   @id @default(cuid())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  data            DateTime @db.Date
  movimentou      Boolean
  registradoPorId String
  registradoPor   User     @relation(fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clienteId, data])
  @@index([data])
}

// ===========================================================================
// CERTIFICADOS — estoque global (v13)
// ===========================================================================

/// UM ZIP = exatamente 50 certificados. E estoque GLOBAL: nao tem clienteId.
/// O vinculo comercial acontece so em CertificadoEnvio.
model CertificadoVersao {
  id             String                  @id @default(cuid())
  identificacao  String                  @unique
  descricao      String?
  quantidade     Int                     @default(50)
  status         CertificadoVersaoStatus @default(ATIVA)
  /// O proprio ZIP, guardado como Documento no bucket privado.
  documentoId    String?                 @unique
  documento      Documento?              @relation(fields: [documentoId], references: [id])
  substituiId    String?                 @unique
  substitui      CertificadoVersao?      @relation("VersaoSubstituicao", fields: [substituiId], references: [id])
  substituidaPor CertificadoVersao?      @relation("VersaoSubstituicao")
  criadoPorId    String
  criadoPor      User                    @relation(fields: [criadoPorId], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  certificados Certificado[]
  envios       CertificadoEnvio[]

  @@index([status])
}

/// Uma unidade do ZIP. A numeracao e RELATIVA a versao: 1..50 em cada uma,
/// nunca uma sequencia global. Por isso a unicidade e (versaoId, numero) e um
/// intervalo so faz sentido citado junto da versao.
model Certificado {
  id           String            @id @default(cuid())
  versaoId     String
  versao       CertificadoVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)
  numero       Int
  /// AES-256-GCM. Nunca entra em select de listagem, nunca vai para log, e so
  /// a rota de revelar a le — depois de checar permissao e gravar Auditoria.
  senhaCifrada String
  status       CertificadoStatus @default(DISPONIVEL)
  /// Nulo = ainda em estoque. E esta coluna que separa estoque de distribuicao.
  envioId      String?
  envio        CertificadoEnvio? @relation(fields: [envioId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([versaoId, numero])
  @@index([versaoId, status])
  @@index([envioId])
}

/// Distribuicao ao cliente: UNICO = 1 certificado, LOTE = 10.
model CertificadoEnvio {
  id            String                 @id @default(cuid())
  clienteId     String
  cliente       Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  versaoId      String
  versao        CertificadoVersao      @relation(fields: [versaoId], references: [id])
  tipo          CertificadoEnvioTipo
  quantidade    Int
  numeroInicial Int
  numeroFinal   Int
  status        CertificadoEnvioStatus @default(ENVIADO)
  observacao    String?
  enviadoPorId  String
  enviadoPor    User                   @relation(fields: [enviadoPorId], references: [id])
  enviadoEm     DateTime               @default(now())
  canceladoEm   DateTime?

  certificados Certificado[]

  @@index([clienteId, enviadoEm])
  @@index([versaoId])
}

// ===========================================================================
// COMPLIANCE (v13)
// ===========================================================================

model PendenciaCompliance {
  id            String               @id @default(cuid())
  clienteId     String
  cliente       Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motivo        PendenciaMotivo
  /// Reusa a escala que ja existe no sistema em vez de criar outra igual.
  criticidade   IncidenteCriticidade @default(MEDIA)
  observacoes   String?
  prazo         DateTime?
  status        PendenciaStatus      @default(ABERTA)
  responsavelId String
  responsavel   User                 @relation("PendenciaResponsavel", fields: [responsavelId], references: [id])
  resolvidaEm   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  eventos PendenciaEvento[]

  @@index([clienteId, status])
  @@index([status, prazo])
}

/// Linha do tempo da pendencia. Tabela propria pela mesma razao de
/// PipelineMovimentacao: `Auditoria.detalhes` e texto livre e nao permite
/// montar timeline nem filtrar por cliente.
model PendenciaEvento {
  id          String              @id @default(cuid())
  pendenciaId String
  pendencia   PendenciaCompliance @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  statusDe    PendenciaStatus?
  statusPara  PendenciaStatus?
  comentario  String?
  createdAt   DateTime            @default(now())

  @@index([pendenciaId, createdAt])
}

// ===========================================================================
// FINANCEIRO (v16)
//
// Quatro registros, nenhum deles duplicando o que ja existia:
//
//   CategoriaFinanceira  -> como a receita/despesa e classificada
//   Fornecedor           -> quem presta o servico
//   LancamentoFinanceiro -> a receita/despesa em si (+ anexos)
//   CondicaoComercial    -> BaaS e White Label, com historico de taxas
//
// ContaReceber continua sendo o faturamento do cliente e NAO virou lancamento:
// sao coisas diferentes (uma tem cliente e vencimento, a outra e caixa).
// ===========================================================================

enum TipoLancamento {
  RECEITA
  DESPESA
}

/// Como o lancamento se repete no tempo.
enum PeriodicidadeLancamento {
  UNICA
  RECORRENTE
  PARCELADA
}

enum StatusLancamento {
  PENDENTE
  PAGO
  CANCELADO
}

/// Natureza do parceiro em CondicaoComercial. E o que permite contar
/// "BaaS ativos" e "White Labels ativos" de uma unica fonte.
enum TipoParceiro {
  BAAS
  WHITE_LABEL
}

/// Categoria de receita OU de despesa. O `tipo` e o que separa as duas listas
/// na tela; nao existem duas tabelas para a mesma coisa.
model CategoriaFinanceira {
  id        String         @id @default(cuid())
  nome      String
  tipo      TipoLancamento
  ativo     Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  lancamentos  LancamentoFinanceiro[]
  fornecedores Fornecedor[]

  @@unique([nome, tipo])
  @@index([tipo, ativo])
}

model Fornecedor {
  id               String               @id @default(cuid())
  razaoSocial      String
  cnpj             String?
  chavePix         String?
  descricaoServico String?
  categoriaId      String?
  categoria        CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  ativo            Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([ativo])
  @@index([categoriaId])
}

/// UMA linha = UM valor com UMA data. Parcelas e recorrencias sao
/// MATERIALIZADAS: um cadastro em 6x gera 6 linhas, uma por mes, amarradas por
/// `grupoId`.
///
/// A razao e que assim Receita, Despesa e Resultado de qualquer periodo sao uma
/// soma direta sobre `data` — sem nenhum motor que "expanda" recorrencia na
/// leitura, que e onde esse tipo de tela normalmente passa a divergir de si
/// mesma dependendo do filtro aplicado.
model LancamentoFinanceiro {
  id            String                  @id @default(cuid())
  tipo          TipoLancamento
  descricao     String
  categoriaId   String
  categoria     CategoriaFinanceira     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  valor         Float
  data          DateTime                @db.Date
  status        StatusLancamento        @default(PENDENTE)
  observacao    String?
  periodicidade PeriodicidadeLancamento @default(UNICA)
  /// Amarra as linhas nascidas do mesmo cadastro. Nulo em lancamento unico.
  grupoId       String?
  parcela       Int?
  totalParcelas Int?

  criadoPorId String
  criadoPor   User   @relation("LancamentoCriador", fields: [criadoPorId], references: [id])

  anexos LancamentoAnexo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
  @@index([tipo, data])
  @@index([categoriaId])
  @@index([grupoId])
  @@index([status])
}

/// Nota fiscal, comprovante de pagamento, print. Os bytes vivem no MESMO
/// bucket privado que o resto do sistema usa; aqui so o vinculo.
model LancamentoAnexo {
  id           String               @id @default(cuid())
  lancamentoId String
  lancamento   LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  documentoId  String               @unique
  documento    Documento            @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  @@index([lancamentoId])
}

/// CONDICOES COMERCIAIS de um BaaS ou White Label — as condicoes ATUAIS.
///
/// Fonte unica para tres numeros que antes sairiam de lugares diferentes:
///   * MRR            -> sustentacao + apiMensal das linhas ativas
///   * BaaS ativos    -> contagem de tipo = BAAS, ativo
///   * White Labels   -> contagem de tipo = WHITE_LABEL, ativo
///
/// O passado nao e reescrito aqui: toda alteracao de taxa grava uma linha em
/// CondicaoComercialHistorico antes de sobrescrever o valor.
model CondicaoComercial {
  id               String       @id @default(cuid())
  nomeFantasia     String
  /// Numero da conta / identificacao do parceiro.
  identificacao    String       @unique
  tipo             TipoParceiro
  /// Tarifas por transacao.
  pix              Float?
  kyc              Float?
  /// Mensalidades. Sao as duas parcelas do MRR que vem daqui.
  sustentacao      Float?
  apiMensal        Float?
  overpricePercent Float?
  ativo            Boolean      @default(true)
  observacao       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  historico CondicaoComercialHistorico[]

  @@index([tipo, ativo])
}

/// Uma linha por campo alterado. Guardado como texto porque o historico
/// registra tambem mudancas de `tipo` e `ativo`, que nao sao numeros — e
/// porque o que importa aqui e a leitura da auditoria, nao recalcular nada.
model CondicaoComercialHistorico {
  id            String            @id @default(cuid())
  condicaoId    String
  condicao      CondicaoComercial @relation(fields: [condicaoId], references: [id], onDelete: Cascade)
  campo         String
  valorAnterior String?
  valorNovo     String?
  userId        String
  user          User              @relation("CondicaoHistoricoAutor", fields: [userId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([condicaoId, createdAt])
}
