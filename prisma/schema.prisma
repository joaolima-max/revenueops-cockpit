generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERACIONAL
  COMERCIAL
}

enum LeadStatus {
  NOVO
  QUALIFICADO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum DealStage {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  FECHAMENTO
  GANHO
  PERDIDO
}

enum ModeloOperacional {
  API
  WHITE_LABEL
  BAAS
}

enum ClienteStatus {
  ATIVO
  INATIVO
  PROSPECCAO
  ENCERRADO
}

enum MetaTipo {
  RECEITA_TARIFARIA
  TPV
  SALDO_EM_CONTA
  TRANSACOES
  MEDS

  // Legado: metas criadas antes da revisao da taxonomia ainda usam estes
  // valores em Production. Mantidos para o client conseguir le-las; nao sao
  // oferecidos na criacao de novas metas.
  RECEITA
  MRR
  CLIENTES_ATIVOS
}

enum Segmento {
  IGAMING
  ECOMMERCE
  SAAS
  ERP
  TELECOM
  CRIPTOMOEDAS
  VAREJO
  OUTROS
}

enum OperacaoCom {
  CASH_IN
  CASH_OUT
  BAAS
  WHITE_LABEL
}

enum ScoreRisco {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TarefaPrioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum IncidenteCriticidade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

/// Comportamento da etapa. GANHO e PERDIDO encerram o card: saem das colunas
/// ativas do quadro e gravam `closedAt` no Deal.
enum EtapaTipo {
  NORMAL
  GANHO
  PERDIDO
}

enum MovimentacaoTipo {
  CRIACAO
  MOVIMENTO_ETAPA
  TRANSFERENCIA_FUNIL
}


model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(COMERCIAL)
  active    Boolean  @default(true)
  avatar     String?
  permissoes String?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads          Lead[]          @relation("LeadOwner")
  deals          Deal[]          @relation("DealOwner")
  activities     Activity[]
  clientes       Cliente[]
  tarefasCriadas Tarefa[]        @relation("TarefaCriador")
  tarefasAssign  Tarefa[]        @relation("TarefaResponsavel")
  auditorias     Auditoria[]
  pipelinePermissoes PipelinePermissao[]
  movimentacoes      PipelineMovimentacao[]
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  position  String?
  source    String?
  status    LeadStatus @default(NOVO)
  value     Float?
  notes     String?
  segmento  Segmento?
  operacao  OperacaoCom?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  ownerId    String
  owner      User       @relation("LeadOwner", fields: [ownerId], references: [id])
  deals      Deal[]
  activities Activity[]
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  value       Float
  stage       DealStage @default(PROSPECCAO)
  probability Int       @default(0)
  notes       String?
  expectedAt  DateTime?
  closedAt    DateTime?
  segmento    Segmento?
  operacao    OperacaoCom?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId    String
  owner      User       @relation("DealOwner", fields: [ownerId], references: [id])
  leadId     String?
  lead       Lead?      @relation(fields: [leadId], references: [id])
  activities Activity[]

  /// Funil e etapa em que o card esta AGORA. Nulos apenas ate o backfill da
  /// migration v11 rodar; depois disso todo Deal mora em algum funil.
  funilId    String?
  funil      PipelineFunil? @relation(fields: [funilId], references: [id])
  etapaId    String?
  etapa      PipelineEtapa? @relation(fields: [etapaId], references: [id])
  /// Preenchido quando o card passa para um funil de pos-venda.
  clienteId  String?
  cliente    Cliente?   @relation(fields: [clienteId], references: [id])

  movimentacoes PipelineMovimentacao[]

  @@index([funilId, etapaId])
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  leadId String?
  lead   Lead?  @relation(fields: [leadId], references: [id])
  dealId String?
  deal   Deal?  @relation(fields: [dealId], references: [id])
}

model Cliente {
  id                    String            @id @default(cuid())
  nome                  String
  cnpj                  String?
  email                 String?
  telefone              String?
  modeloOperacional     ModeloOperacional
  status                ClienteStatus     @default(PROSPECCAO)
  segmento              Segmento?
  operacao              OperacaoCom?
  scoreRisco            ScoreRisco?
  dataFechamento        DateTime?
  dataEncerramento      DateTime?
  mensalidadeApi        Float?
  sustentacaoWhiteLabel Float?
  setup                 Float?
  tpvEsperado           Float?
  qtdTransacoesEsperada Int?
  qtdMedEsperada        Int?
  receitaPrevistaMensal Float?
  descontoPercent       Float?
  overpricePercent      Float?
  notas                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])
  tarefas        Tarefa[]
  contasReceber  ContaReceber[]
  followUps      FollowUp[]
  volumetrias    VolumetriaMinima[]
  deals          Deal[]
}




model Meta {
  id        String   @id @default(cuid())
  tipo      MetaTipo
  valor     Float
  periodo   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, periodo])
}

model Tarefa {
  id          String           @id @default(cuid())
  titulo      String
  descricao   String?
  status      TarefaStatus     @default(PENDENTE)
  prioridade  TarefaPrioridade @default(MEDIA)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  clienteId      String?
  cliente        Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  criadoPorId    String
  criadoPor      User     @relation("TarefaCriador", fields: [criadoPorId], references: [id])
  responsavelId  String
  responsavel    User     @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
}

model Incidente {
  id           String              @id @default(cuid())
  titulo       String
  descricao    String?
  inicio       DateTime
  fim          DateTime?
  downtimeMins Int?
  criticidade  IncidenteCriticidade @default(MEDIA)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

}



enum ContaReceberStatus {
  PENDENTE
  FATURADO
  PAGO
  INADIMPLENTE
}

enum FollowUpTipo {
  PICO_OPERACIONAL
  REUNIAO
  MONITORAMENTO
  FOLLOW_UP
  ALERTA
  OUTRO
}

model Auditoria {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String?
  detalhes   String?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Parametro {
  id        String   @id @default(cuid())
  chave     String   @unique
  valor     String
  label     String
  descricao String?
  grupo     String   @default("GERAL")
  tipo      String   @default("NUMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ContaReceber {
  id          String             @id @default(cuid())
  descricao   String
  tipo        String
  valor       Float
  parcela     Int?
  totalParcel Int?
  dataVenc    DateTime
  dataFatura  DateTime?
  dataPago    DateTime?
  status      ContaReceberStatus @default(PENDENTE)
  notas       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  clienteId   String
  cliente     Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id          String       @id @default(cuid())
  titulo      String
  descricao   String?
  tipo        FollowUpTipo @default(FOLLOW_UP)
  recorrente  Boolean      @default(false)
  diaSemana   Int?
  horaInicio  String?
  horaFim     String?
  dataInicio  DateTime?
  dataFim     DateTime?
  notas           String?
  frequenciaDias  Int?
  ultimoContato   DateTime?
  proximoContato  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  clienteId       String
  cliente         Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

/// FONTE OFICIAL dos 5 indicadores realizados. Grão: uma data.
/// Nenhum outro modelo grava TPV, receita tarifária, saldo, transações ou MEDs.
model LancamentoDiario {
  id               String   @id @default(cuid())
  data             DateTime @unique @db.Date
  receitaTarifaria Float    @default(0)
  tpv              Float    @default(0)
  saldoEmConta     Float    @default(0)
  qtdTransacoes    Int      @default(0)
  qtdMed           Int      @default(0)
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([data])
}

/// Multiplicador do Float, configuravel pela tela de Parametros.
/// Versionado por vigencia para que periodos fechados nao mudem de valor
/// quando o multiplicador for alterado.
model FloatConfig {
  id             String   @id @default(cuid())
  multiplicador  Float
  vigenciaInicio DateTime @unique @db.Date
  notas          String?
  createdAt      DateTime @default(now())
}

/// Exigencia CONTRATUAL de quantidade minima de transacoes de UM cliente,
/// vigente de `periodo` (YYYY-MM, inicio) ate `vigenciaFim` (inclusive) ou por
/// prazo indeterminado.
///
/// Nao e TPV nem realizado por cliente: o realizado continua vindo, sempre e
/// somente, de LancamentoDiario, que e global por data. O minimo consolidado
/// de um mes e a SOMA dos contratos vigentes naquele mes.
///
/// Linhas com `clienteId` nulo sao contratos GERAIS legados, anteriores a
/// vinculacao por cliente. Preservadas para leitura e para que os alertas de
/// meses ja fechados nao mudem de resultado; a aplicacao nao cria mais linhas
/// assim.
model VolumetriaMinima {
  id          String   @id @default(cuid())
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Inicio da vigencia, "YYYY-MM". Mantem o nome original da coluna.
  periodo     String
  /// Fim da vigencia, "YYYY-MM" inclusive. Nulo = prazo indeterminado.
  vigenciaFim String?
  qtdMinima   Int
  ativo       Boolean  @default(true)
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clienteId, periodo])
  @@index([clienteId, ativo])
}


/// PIPELINE MULTI-FUNIL
///
/// O card NAO e um modelo novo: e o proprio Deal, que ganhou funilId/etapaId.
/// Um unico Deal atravessa Vendas -> Onboarding -> Operacoes, e por isso lead,
/// cliente, dono e atividades continuam associados sem nenhuma copia.

model PipelineFunil {
  id           String   @id @default(cuid())
  nome         String   @unique
  descricao    String?
  /// Area/departamento dono do funil. Rotulo descritivo: quem pode o que fica
  /// em PipelinePermissao, nao aqui.
  area         String?
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  /// Funis de pos-venda exigem um Cliente vinculado ao receber o card.
  exigeCliente Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  etapas     PipelineEtapa[]
  permissoes PipelinePermissao[]
  deals      Deal[]
  movOrigem  PipelineMovimentacao[] @relation("MovFunilOrigem")
  movDestino PipelineMovimentacao[] @relation("MovFunilDestino")

  @@index([ativo, ordem])
}

model PipelineEtapa {
  id        String        @id @default(cuid())
  funilId   String
  funil     PipelineFunil @relation(fields: [funilId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  /// Posicao da coluna. Indice NAO unico de proposito: um unique quebraria
  /// qualquer troca de posicao entre duas etapas.
  ordem     Int           @default(0)
  cor       String?
  ativo     Boolean       @default(true)
  tipo      EtapaTipo     @default(NORMAL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deals      Deal[]
  movOrigem  PipelineMovimentacao[] @relation("MovEtapaOrigem")
  movDestino PipelineMovimentacao[] @relation("MovEtapaDestino")

  @@unique([funilId, nome])
  @@index([funilId, ordem])
}

/// Alcada de UM funil para UMA role ou UM usuario — nunca os dois na mesma
/// linha. Nao substitui o sistema de permissoes: refina, dentro do modulo,
/// o que `view_pipeline`/`manage_pipeline` ja liberaram.
model PipelinePermissao {
  id      String        @id @default(cuid())
  funilId String
  funil   PipelineFunil @relation(fields: [funilId], references: [id], onDelete: Cascade)
  role    Role?
  userId  String?
  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  ver         Boolean @default(true)
  editar      Boolean @default(false)
  mover       Boolean @default(false)
  criar       Boolean @default(false)
  transferir  Boolean @default(false)
  administrar Boolean @default(false)
  /// Preserva a regra que hoje esta embutida no codigo: o COMERCIAL so
  /// enxerga os proprios negocios.
  apenasProprios Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funilId, role])
  @@unique([funilId, userId])
  @@index([funilId])
}

/// Historico do card. Coexiste com Auditoria: o `detalhes` da Auditoria e
/// texto livre e nao permite montar uma linha do tempo com origem e destino,
/// nem filtrar por funil.
model PipelineMovimentacao {
  id     String           @id @default(cuid())
  dealId String
  deal   Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tipo   MovimentacaoTipo

  funilOrigemId  String?
  funilOrigem    PipelineFunil? @relation("MovFunilOrigem", fields: [funilOrigemId], references: [id])
  etapaOrigemId  String?
  etapaOrigem    PipelineEtapa? @relation("MovEtapaOrigem", fields: [etapaOrigemId], references: [id])
  funilDestinoId String
  funilDestino   PipelineFunil  @relation("MovFunilDestino", fields: [funilDestinoId], references: [id])
  etapaDestinoId String
  etapaDestino   PipelineEtapa  @relation("MovEtapaDestino", fields: [etapaDestinoId], references: [id])

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  observacao String?
  createdAt  DateTime @default(now())

  @@index([dealId, createdAt])
  @@index([funilDestinoId, createdAt])
}
