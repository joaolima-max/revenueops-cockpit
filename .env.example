# ─────────────────────────────────────────────────────────────────────────────
# RevenueOps Cockpit — variáveis exigidas. Nenhum valor real aqui.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Supabase em produção). Server-only.
DATABASE_URL=

# Assinatura do cookie de sessão. Server-only.
JWT_SECRET=

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Bucket PRIVADO `cliente-arquivos`. Crie com: npm run setup:storage
# A URL é pública; a service role key NUNCA pode receber o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Certificados ─────────────────────────────────────────────────────────────
# Cifragem AES-256-GCM das senhas. Server-only.
# Gere 32 bytes em hex (64 caracteres):  openssl rand -hex 32
# Outro formato funciona (é derivado por SHA-256), mas hex de 32 bytes é o ideal.
CERTIFICADO_ENCRYPTION_KEY=
